{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=YOLOVisionStudio.db"
  },
  "YoloAiEngine": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 30,
    "CondaEnvPath": "D:\\WorkSpace\\CondaEnv\\AmalAI",
    "ModelsPath": "wwwroot/models"
  },
  "JwtSettings": {
    "Secret": "A_Very_Long_Secret_Key_For_Jwt_Generation_Change_In_Prod",
    "Issuer": "YOLOVisionStudio",
    "Audience": "YOLOVisionStudioUsers"
  },
  "UploadSettings": {
    "MaxFileSizeMB": 500,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".zip", ".txt", ".json", ".xml" ]
  },
  "TrainingDefaults": {
    "DefaultEpochs": 100,
    "DefaultImageSize": 640,
    "DefaultBatchSize": 16
  }
}
