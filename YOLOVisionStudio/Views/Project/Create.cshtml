@{
    ViewData["Title"] = "Create Project";
}

<style>
    .wizard-step { display: none; }
    .wizard-step.active { display: block; animation: fadeIn 0.3s; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .emoji-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-width: 300px; margin-top: 10px; }
    .emoji-item { font-size: 2rem; cursor: pointer; text-align: center; padding: 10px; border-radius: var(--radius-lg); border: 2px solid transparent; background: var(--color-card); transition: all 0.2s; }
    .emoji-item:hover { background: var(--color-border); }
    .emoji-item.selected { border-color: var(--color-primary-start); background: rgba(124, 58, 237, 0.1); }
    .task-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 20px; }
    .task-card { background: var(--color-card); border: 2px solid var(--color-border); border-radius: var(--radius-xl); padding: 20px; cursor: pointer; text-align: center; transition: all 0.2s; }
    .task-card:hover { border-color: var(--color-primary-end); transform: translateY(-2px); }
    .task-card.selected { border-color: var(--color-primary-start); box-shadow: 0 0 15px rgba(124, 58, 237, 0.3); }
    .task-icon { font-size: 3rem; margin-bottom: 10px; }
    .step-indicators { display: flex; align-items: center; justify-content: center; margin-bottom: 30px; }
    .step-dot { width: 30px; height: 30px; border-radius: 50%; background: var(--color-border); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-weight: bold; }
    .step-dot.active { background: var(--color-primary-start); color: white; }
    .step-dot.done { background: var(--color-success); color: white; }
    .step-connector { height: 4px; width: 50px; background: var(--color-border); margin: 0 10px; }
    .step-connector.done { background: var(--color-success); }
</style>

<div class="page-header">
    <h1 class="page-title gradient-text">Create New Project</h1>
    <p class="page-subtitle">Set up a new computer vision workspace</p>
</div>

<div class="step-indicators">
    <div class="step-dot active" id="dot-1">1</div>
    <div class="step-connector" id="conn-1"></div>
    <div class="step-dot" id="dot-2">2</div>
    <div class="step-connector" id="conn-2"></div>
    <div class="step-dot" id="dot-3">3</div>
</div>

<form id="createProjectForm" method="post" action="/Project/Create">
    @Html.AntiForgeryToken()
    
    <!-- Step 1 -->
    <div class="wizard-step active" id="step-1">
        <div class="card p-4">
            <h3 class="mb-3">Project Basics</h3>
            <div class="form-group mb-3">
                <label>Project Name</label>
                <input type="text" class="form-control" name="Name" id="projectName" placeholder="e.g., Helmet Detection" required>
            </div>
            <div class="form-group mb-3">
                <label>Description</label>
                <textarea class="form-control" name="Description" id="projectDesc" rows="3" placeholder="Describe the project goal..."></textarea>
            </div>
            <div class="form-group mb-3">
                <label>Project Icon</label>
                <input type="hidden" name="Icon" id="projectIcon" value="ًںڑ€">
                <div class="emoji-grid">
                    <div class="emoji-item selected" onclick="selectEmoji(this, 'ًںڑ€')">ًںڑ€</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًں¤–')">ًں¤–</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًں‘پï¸ڈ')">ًں‘پï¸ڈ</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًںڈ­')">ًںڈ­</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًںڑ—')">ًںڑ—</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًں§چ')">ًں§چ</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًں“¦')">ًں“¦</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًں©؛')">ًں©؛</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًںŒ؟')">ًںŒ؟</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًں”¥')">ًں”¥</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'ًں›،ï¸ڈ')">ًں›،ï¸ڈ</div>
                    <div class="emoji-item" onclick="selectEmoji(this, 'âڑ،')">âڑ،</div>
                </div>
            </div>
            <div class="text-end">
                <button type="button" class="btn btn-primary" onclick="nextStep(2)">Next: Task Type <i class="fas fa-arrow-right ml-2"></i></button>
            </div>
        </div>
    </div>

    <!-- Step 2 -->
    <div class="wizard-step" id="step-2">
        <div class="card p-4">
            <h3 class="mb-3">Select Task Type</h3>
            <input type="hidden" name="TaskType" id="projectTask" value="Detection">
            <div class="task-cards">
                <div class="task-card selected" onclick="selectTask(this, 'Detection')">
                    <div class="task-icon">ًں”²</div>
                    <h4>Object Detection</h4>
                    <p class="text-muted">Locate and classify objects with bounding boxes.</p>
                </div>
                <div class="task-card" onclick="selectTask(this, 'Segmentation')">
                    <div class="task-icon">ًںژ¨</div>
                    <h4>Instance Segmentation</h4>
                    <p class="text-muted">Pixel-level object outlines and classification.</p>
                </div>
                <div class="task-card" onclick="selectTask(this, 'Pose')">
                    <div class="task-icon">ًں§چ</div>
                    <h4>Pose Estimation</h4>
                    <p class="text-muted">Detect keypoints and skeletons in images.</p>
                </div>
                <div class="task-card" onclick="selectTask(this, 'Classification')">
                    <div class="task-icon">ًںڈ·ï¸ڈ</div>
                    <h4>Image Classification</h4>
                    <p class="text-muted">Assign a single label to the entire image.</p>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-outline" onclick="prevStep(1)"><i class="fas fa-arrow-left mr-2"></i> Back</button>
                <button type="button" class="btn btn-primary" onclick="nextStep(3)">Next: Review <i class="fas fa-arrow-right ml-2"></i></button>
            </div>
        </div>
    </div>

    <!-- Step 3 -->
    <div class="wizard-step" id="step-3">
        <div class="card p-4">
            <h3 class="mb-3">Review & Create</h3>
            <div class="review-summary bg-dark p-4 rounded mb-4" style="border: 1px solid var(--color-border);">
                <div class="d-flex align-items-center mb-3">
                    <div id="reviewIcon" style="font-size: 3rem; margin-right: 20px;">ًںڑ€</div>
                    <div>
                        <h4 id="reviewName" class="mb-1 text-primary">Project Name</h4>
                        <span id="reviewTask" class="badge badge-info">Detection</span>
                    </div>
                </div>
                <p id="reviewDesc" class="text-muted">Description goes here.</p>
            </div>
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-outline" onclick="prevStep(2)"><i class="fas fa-arrow-left mr-2"></i> Back</button>
                <button type="submit" class="btn btn-primary bg-success border-0">Create Project <i class="fas fa-check ml-2"></i></button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function selectEmoji(el, emoji) {
            document.querySelectorAll('.emoji-item').forEach(e => e.classList.remove('selected'));
            el.classList.add('selected');
            document.getElementById('projectIcon').value = emoji;
        }

        function selectTask(el, task) {
            document.querySelectorAll('.task-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            document.getElementById('projectTask').value = task;
        }

        function nextStep(step) {
            if (step === 2 && !document.getElementById('projectName').value) {
                alert('Please enter a project name.');
                return;
            }
            
            if (step === 3) {
                // Populate review
                document.getElementById('reviewName').innerText = document.getElementById('projectName').value;
                document.getElementById('reviewDesc').innerText = document.getElementById('projectDesc').value || 'No description provided.';
                document.getElementById('reviewIcon').innerText = document.getElementById('projectIcon').value;
                document.getElementById('reviewTask').innerText = document.getElementById('projectTask').value;
            }

            document.querySelectorAll('.wizard-step').forEach(s => s.classList.remove('active'));
            document.getElementById('step-' + step).classList.add('active');
            
            // Update dots
            let current = step - 1;
            document.getElementById('dot-' + current).classList.remove('active');
            document.getElementById('dot-' + current).classList.add('done');
            if(document.getElementById('conn-' + current)) {
                document.getElementById('conn-' + current).classList.add('done');
            }
            document.getElementById('dot-' + step).classList.add('active');
        }

        function prevStep(step) {
            document.querySelectorAll('.wizard-step').forEach(s => s.classList.remove('active'));
            document.getElementById('step-' + step).classList.add('active');
            
            let next = step + 1;
            document.getElementById('dot-' + next).classList.remove('active');
            document.getElementById('dot-' + step).classList.remove('done');
            document.getElementById('dot-' + step).classList.add('active');
            if(document.getElementById('conn-' + step)) {
                document.getElementById('conn-' + step).classList.remove('done');
            }
        }
    </script>
}

