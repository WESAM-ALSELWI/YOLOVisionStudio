@{
    ViewData["Title"] = "Training History";
}

<style>
    .filter-bar { background: var(--color-card); padding: 15px 20px; border-radius: var(--radius-lg); display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border: 1px solid var(--color-border); }
    
    .history-table { width: 100%; border-collapse: collapse; background: var(--color-card); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border); }
    .history-table th { background: rgba(0,0,0,0.2); padding: 15px; text-align: left; color: var(--text-muted); font-weight: 500; font-size: 0.85rem; text-transform: uppercase; border-bottom: 1px solid var(--color-border); }
    .history-table td { padding: 15px; border-bottom: 1px solid var(--color-border); vertical-align: middle; }
    .history-table tr:last-child td { border-bottom: none; }
    .history-table tr:hover { background: rgba(255,255,255,0.02); }
    
    .status-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; }
    .status-dot.running { background: var(--color-primary-start); box-shadow: 0 0 8px var(--color-primary-start); animation: pulse 1.5s infinite; }
    .status-dot.completed { background: var(--color-success); }
    .status-dot.failed { background: var(--color-error); }
    .status-dot.pending { background: var(--color-warning); }
    @@keyframes pulse { 0% { transform: scale(0.95); opacity: 0.5; } 50% { transform: scale(1.1); opacity: 1; } 100% { transform: scale(0.95); opacity: 0.5; } }
    
    .chip { display: inline-block; padding: 2px 8px; border-radius: 12px; background: rgba(255,255,255,0.1); font-size: 0.75rem; margin-right: 5px; color: var(--text-secondary); border: 1px solid rgba(255,255,255,0.05); }
    
    .expandable-row { display: none; background: #0a0c10; }
    .expandable-row.open { display: table-row; }
    .details-box { padding: 20px; border-left: 3px solid var(--color-primary-start); margin: 10px; background: rgba(255,255,255,0.03); border-radius: 0 8px 8px 0; }
    
    .metric-mini { display: inline-block; margin-right: 20px; }
    .metric-mini-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; }
    .metric-mini-val { font-size: 1.1rem; font-weight: bold; }
</style>

<div class="page-header">
    <h1 class="page-title">Training History</h1>
    <p class="page-subtitle">Log of all model training executions</p>
</div>

<div class="filter-bar">
    <div class="d-flex align-items-center gap-3">
        <select class="form-control bg-dark text-white border-secondary" style="width: 150px;">
            <option>All Statuses</option>
            <option>Running</option>
            <option>Completed</option>
            <option>Failed</option>
        </select>
        <select class="form-control bg-dark text-white border-secondary" style="width: 150px;">
            <option>All Models</option>
            <option>YOLOv8</option>
            <option>YOLOv7</option>
        </select>
    </div>
    <div class="d-flex align-items-center">
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fas fa-search"></i></span>
            </div>
            <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Search job name..." style="width: 250px;">
        </div>
    </div>
</div>

<table class="history-table">
    <thead>
        <tr>
            <th style="width: 40px;"></th>
            <th>Job Name</th>
            <th>Model</th>
            <th>Dataset</th>
            <th>Epochs</th>
            <th>mAP50</th>
            <th>Duration</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <!-- Row 1: Running -->
        <tr>
            <td class="text-center cursor-pointer" onclick="toggleRow(1)"><i class="fas fa-chevron-right text-muted" id="icon-1"></i></td>
            <td class="font-weight-bold">Run-12-Augmented</td>
            <td><span class="badge badge-info">YOLOv8m</span></td>
            <td>Site-Images-v3</td>
            <td>145 / 300</td>
            <td>--</td>
            <td>2h 14m</td>
            <td><span class="status-dot running"></span> Running</td>
            <td>
                <button class="btn btn-sm btn-primary py-1"><i class="fas fa-desktop mr-1"></i> Monitor</button>
            </td>
        </tr>
        <tr class="expandable-row" id="row-1">
            <td colspan="9">
                <div class="details-box">
                    <div class="mb-3">
                        <span class="metric-mini"><div class="metric-mini-label">Batch Size</div><div class="metric-mini-val">16</div></span>
                        <span class="metric-mini"><div class="metric-mini-label">Img Size</div><div class="metric-mini-val">640</div></span>
                        <span class="metric-mini"><div class="metric-mini-label">Optimizer</div><div class="metric-mini-val">AdamW</div></span>
                        <span class="metric-mini"><div class="metric-mini-label">LR Initial</div><div class="metric-mini-val">0.001</div></span>
                        <span class="metric-mini"><div class="metric-mini-label">GPU</div><div class="metric-mini-val text-info">RTX 4090 (98%)</div></span>
                    </div>
                    <div>
                        <div class="text-muted small mb-1">Hyperparameters</div>
                        <span class="chip">mosaic: 1.0</span> <span class="chip">mixup: 0.1</span> <span class="chip">fliplr: 0.5</span> <span class="chip">degrees: 10.0</span>
                    </div>
                </div>
            </td>
        </tr>

        <!-- Row 2: Completed -->
        <tr>
            <td class="text-center cursor-pointer" onclick="toggleRow(2)"><i class="fas fa-chevron-right text-muted" id="icon-2"></i></td>
            <td class="font-weight-bold">Run-11-Baseline</td>
            <td><span class="badge badge-info">YOLOv8m</span></td>
            <td>Site-Images-v2</td>
            <td>300 / 300</td>
            <td class="text-success font-weight-bold">89.4%</td>
            <td>4h 12m</td>
            <td><span class="status-dot completed"></span> Completed</td>
            <td>
                <button class="btn btn-sm btn-outline py-1"><i class="fas fa-download"></i></button>
                <button class="btn btn-sm btn-outline py-1 text-danger border-danger"><i class="fas fa-trash"></i></button>
            </td>
        </tr>
        <tr class="expandable-row" id="row-2">
            <td colspan="9">
                <div class="details-box">
                    <div class="mb-3">
                        <span class="metric-mini"><div class="metric-mini-label">Best Epoch</div><div class="metric-mini-val">284</div></span>
                        <span class="metric-mini"><div class="metric-mini-label">mAP50-95</div><div class="metric-mini-val">64.2%</div></span>
                        <span class="metric-mini"><div class="metric-mini-label">Precision</div><div class="metric-mini-val">87.1%</div></span>
                        <span class="metric-mini"><div class="metric-mini-label">Recall</div><div class="metric-mini-val">84.5%</div></span>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-outline mr-2">View Charts</button>
                        <button class="btn btn-sm btn-outline mr-2">Export Model</button>
                    </div>
                </div>
            </td>
        </tr>
        
        <!-- Row 3: Completed -->
        <tr>
            <td class="text-center cursor-pointer"><i class="fas fa-chevron-right text-muted"></i></td>
            <td class="font-weight-bold">Run-10-Nano-Fast</td>
            <td><span class="badge badge-secondary">YOLOv8n</span></td>
            <td>Site-Images-v2</td>
            <td>200 / 200</td>
            <td>74.5%</td>
            <td>1h 30m</td>
            <td><span class="status-dot completed"></span> Completed</td>
            <td>
                <button class="btn btn-sm btn-outline py-1"><i class="fas fa-download"></i></button>
                <button class="btn btn-sm btn-outline py-1 text-danger border-danger"><i class="fas fa-trash"></i></button>
            </td>
        </tr>

        <!-- Row 4: Failed -->
        <tr>
            <td class="text-center cursor-pointer"><i class="fas fa-chevron-right text-muted"></i></td>
            <td class="font-weight-bold">Run-09-Large</td>
            <td><span class="badge badge-primary">YOLOv8l</span></td>
            <td>Site-Images-v2</td>
            <td>12 / 300</td>
            <td>--</td>
            <td>0h 15m</td>
            <td><span class="status-dot failed"></span> Failed (OOM)</td>
            <td>
                <button class="btn btn-sm btn-outline py-1"><i class="fas fa-list-alt"></i> Logs</button>
            </td>
        </tr>
        
        <!-- Row 5: Completed -->
        <tr>
            <td class="text-center cursor-pointer"><i class="fas fa-chevron-right text-muted"></i></td>
            <td class="font-weight-bold">Run-08-Test</td>
            <td><span class="badge badge-info">YOLOv8m</span></td>
            <td>Initial-Batch</td>
            <td>100 / 100</td>
            <td>65.2%</td>
            <td>0h 45m</td>
            <td><span class="status-dot completed"></span> Completed</td>
            <td>
                <button class="btn btn-sm btn-outline py-1"><i class="fas fa-download"></i></button>
                <button class="btn btn-sm btn-outline py-1 text-danger border-danger"><i class="fas fa-trash"></i></button>
            </td>
        </tr>

        <!-- Row 6: Failed -->
        <tr>
            <td class="text-center cursor-pointer"><i class="fas fa-chevron-right text-muted"></i></td>
            <td class="font-weight-bold">Run-07-OldData</td>
            <td><span class="badge badge-info">YOLOv8m</span></td>
            <td>Initial-Batch</td>
            <td>0 / 100</td>
            <td>--</td>
            <td>0h 01m</td>
            <td><span class="status-dot failed"></span> Failed (Data Error)</td>
            <td>
                <button class="btn btn-sm btn-outline py-1"><i class="fas fa-list-alt"></i> Logs</button>
            </td>
        </tr>

        <!-- Row 7: Completed -->
        <tr>
            <td class="text-center cursor-pointer"><i class="fas fa-chevron-right text-muted"></i></td>
            <td class="font-weight-bold">Run-06-Demo</td>
            <td><span class="badge badge-secondary">YOLOv8n</span></td>
            <td>Demo-Set</td>
            <td>50 / 50</td>
            <td>52.1%</td>
            <td>0h 10m</td>
            <td><span class="status-dot completed"></span> Completed</td>
            <td>
                <button class="btn btn-sm btn-outline py-1"><i class="fas fa-download"></i></button>
                <button class="btn btn-sm btn-outline py-1 text-danger border-danger"><i class="fas fa-trash"></i></button>
            </td>
        </tr>

        <!-- Row 8: Pending -->
        <tr>
            <td class="text-center cursor-pointer"><i class="fas fa-chevron-right text-muted"></i></td>
            <td class="font-weight-bold">Run-13-Queued</td>
            <td><span class="badge badge-primary">YOLOv8x</span></td>
            <td>Site-Images-v3</td>
            <td>0 / 500</td>
            <td>--</td>
            <td>--</td>
            <td><span class="status-dot pending"></span> Queued</td>
            <td>
                <button class="btn btn-sm btn-outline py-1 text-danger border-danger"><i class="fas fa-times"></i> Cancel</button>
            </td>
        </tr>
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="text-muted small">Showing 1 to 8 of 24 entries</div>
    <ul class="pagination mb-0" style="display: flex; list-style: none; gap: 5px;">
        <li><button class="btn btn-sm btn-outline" disabled>&laquo;</button></li>
        <li><button class="btn btn-sm btn-primary">1</button></li>
        <li><button class="btn btn-sm btn-outline">2</button></li>
        <li><button class="btn btn-sm btn-outline">3</button></li>
        <li><button class="btn btn-sm btn-outline">&raquo;</button></li>
    </ul>
</div>

@section Scripts {
    <script>
        function toggleRow(id) {
            let row = document.getElementById('row-' + id);
            let icon = document.getElementById('icon-' + id);
            
            if (row.classList.contains('open')) {
                row.classList.remove('open');
                icon.className = 'fas fa-chevron-right text-muted';
            } else {
                row.classList.add('open');
                icon.className = 'fas fa-chevron-down text-primary';
            }
        }
    </script>
}

