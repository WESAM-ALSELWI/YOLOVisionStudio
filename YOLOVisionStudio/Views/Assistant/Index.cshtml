@{
    ViewData["Title"] = "AI Assistant";
}

<div class="glass-card" style="height: calc(100vh - 120px); display: flex; flex-direction: column;">
    <div style="flex: 1; overflow-y: auto; padding: 16px;">
        <div style="display: flex; gap: 16px; margin-bottom: 24px;">
            <div class="user-avatar" style="background: var(--color-border);"><i data-feather="cpu"></i></div>
            <div class="glass-card" style="padding: 12px 16px; max-width: 80%;">
                Hello! I am your YOLO Vision AI Assistant. I can help you configure training jobs, understand model architectures, or troubleshoot dataset issues. What would you like to build today?
            </div>
        </div>
    </div>
    
    <div style="padding: 16px; border-top: 1px solid var(--color-border);">
        <div style="display: flex; gap: 8px; margin-bottom: 12px;">
            <button class="badge badge-info" style="cursor:pointer;">I want to detect cars</button>
            <button class="badge badge-info" style="cursor:pointer;">How to improve accuracy?</button>
            <button class="badge badge-info" style="cursor:pointer;">Explain YOLO architecture</button>
        </div>
        <div style="display: flex; gap: 12px;">
            <input type="text" class="form-control" placeholder="Ask anything..." style="flex: 1;" />
            <button class="btn btn-primary"><i data-feather="send"></i></button>
        </div>
    </div>
</div>
