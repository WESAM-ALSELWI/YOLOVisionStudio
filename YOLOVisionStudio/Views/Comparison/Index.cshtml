@{
    ViewData["Title"] = "Model Comparison";
}
<div class="glass-card" style="margin-bottom:24px;">
    <h3>Compare Models</h3>
    <div style="display:flex; gap:16px; margin-top:16px;">
        <select class="form-control" style="flex:1;">
            <option>YOLOv11-Large</option>
            <option>YOLOv11-Medium</option>
        </select>
        <button class="btn btn-primary">Compare</button>
    </div>
</div>
<div class="grid grid-cols-2">
    <div class="glass-card" style="height: 400px; display:flex; align-items:center; justify-content:center; color:var(--text-muted);">
        Radar Chart Placeholder
    </div>
    <div class="glass-card" style="height: 400px; display:flex; align-items:center; justify-content:center; color:var(--text-muted);">
        Bar Chart Placeholder
    </div>
</div>
