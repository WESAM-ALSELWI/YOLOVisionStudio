@{
    ViewData["Title"] = "Error";
}
<div class="glass-card" style="text-align:center; padding: 60px;">
    <i data-feather="alert-triangle" style="width: 64px; height: 64px; color: var(--color-error); margin-bottom: 24px;"></i>
    <h1 style="color: var(--color-error);">An error occurred.</h1>
    <p style="color: var(--text-secondary); margin-top: 16px;">While processing your request, something went wrong.</p>
</div>
