@{
    ViewData["Title"] = "Layer Statistics Dashboard";
}

<style>
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px; }
    .stat-card { background: var(--color-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 15px; }
    .stat-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--color-border); }
    .stat-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .metric-item { background: rgba(0,0,0,0.2); padding: 8px; border-radius: 6px; }
    .metric-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; }
    .metric-value { font-size: 0.9rem; font-weight: bold; color: var(--color-primary-end); }
    .metric-value.warning { color: #f59e0b; }
    .metric-value.danger { color: #ef4444; }
    .metric-value.success { color: #10b981; }
    
    .progress-bar { height: 6px; background: #1f2937; border-radius: 3px; overflow: hidden; margin-top: 4px; }
    .progress-fill { height: 100%; background: var(--color-primary-start); transition: width 0.3s; }
    
    .controls { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .controls select, .controls input { flex: 1; min-width: 150px; }
    
    .refresh-btn { animation: pulse 2s infinite; }
    @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
</style>

<div class="page-header">
    <h1 class="page-title">Layer Statistics Dashboard</h1>
    <p class="page-subtitle">Real-time monitoring of activation statistics, sparsity, and gradient flow</p>
</div>

<div class="controls">
    <select id="jobSelect" class="form-control">
        <option value="">Select Training Job</option>
    </select>
    <button class="btn btn-primary refresh-btn" onclick="loadStatistics()">
        <i class="fas fa-sync-alt mr-2"></i> Refresh
    </button>
    <button class="btn btn-outline-secondary" onclick="toggleAutoRefresh()">
        <i class="fas fa-clock mr-2"></i> Auto Refresh: <span id="autoRefreshStatus">OFF</span>
    </button>
</div>

<div id="statsContainer" class="stats-grid">
    <!-- Statistics cards will be dynamically inserted here -->
</div>

<div id="emptyState" class="empty-state">
    <i data-feather="bar-chart-2" style="width:64px;height:64px;opacity:0.2;margin-bottom:16px;"></i>
    <h4>No Training Job Selected</h4>
    <p style="font-size:0.875rem;margin-top:8px;">Select an active training job to view real-time layer statistics</p>
</div>

<div id="loadingSection" style="display: none; text-align: center; padding: 40px;">
    <div class="spinner-border text-primary" role="status">
        <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-3">Loading layer statistics...</p>
</div>

@section Scripts {
    <script>
        let autoRefreshInterval = null;
        let currentJobId = null;

        async function loadStatistics() {
            const jobId = document.getElementById('jobSelect').value;
            if (!jobId) {
                alert('Please select a training job');
                return;
            }

            currentJobId = jobId;
            showLoading(true);

            try {
                const response = await fetch(`/Visualization/GetLayerStatistics?jobId=${encodeURIComponent(jobId)}`);
                const data = await response.json();

                if (data.layer_statistics && data.layer_statistics.length > 0) {
                    renderStatistics(data.layer_statistics);
                } else {
                    document.getElementById('statsContainer').innerHTML = '';
                    document.getElementById('emptyState').style.display = 'block';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Failed to load layer statistics. Make sure the Python AI engine is running.');
            } finally {
                showLoading(false);
            }
        }

        function renderStatistics(stats) {
            const container = document.getElementById('statsContainer');
            container.innerHTML = '';
            document.getElementById('emptyState').style.display = 'none';

            stats.forEach(stat => {
                const card = document.createElement('div');
                card.className = 'stat-card';

                const sparsityClass = stat.sparsity > 50 ? 'danger' : stat.sparsity > 20 ? 'warning' : 'success';
                const gradNormClass = stat.grad_norm < 0.001 ? 'danger' : stat.grad_norm < 0.01 ? 'warning' : 'success';

                card.innerHTML = `
                    <div class="stat-header">
                        <h6 style="margin:0;">${stat.layer_name}</h6>
                        <span class="badge badge-secondary" style="font-size:0.7rem;">${stat.layer_type}</span>
                    </div>
                    <div class="stat-metrics">
                        <div class="metric-item">
                            <div class="metric-label">Mean</div>
                            <div class="metric-value">${stat.mean.toFixed(4)}</div>
                        </div>
                        <div class="metric-item">
                            <div class="metric-label">Std Dev</div>
                            <div class="metric-value">${stat.std.toFixed(4)}</div>
                        </div>
                        <div class="metric-item">
                            <div class="metric-label">Min / Max</div>
                            <div class="metric-value" style="font-size:0.8rem;">${stat.min.toFixed(3)} / ${stat.max.toFixed(3)}</div>
                        </div>
                        <div class="metric-item">
                            <div class="metric-label">Shape</div>
                            <div class="metric-value" style="font-size:0.75rem;">[${stat.shape.join(', ')}]</div>
                        </div>
                        <div class="metric-item">
                            <div class="metric-label">Sparsity</div>
                            <div class="metric-value ${sparsityClass}">${stat.sparsity.toFixed(1)}%</div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: ${stat.sparsity}%; background: ${stat.sparsity > 50 ? '#ef4444' : stat.sparsity > 20 ? '#f59e0b' : '#10b981'};"></div>
                            </div>
                        </div>
                        <div class="metric-item">
                            <div class="metric-label">Dead Neurons</div>
                            <div class="metric-value ${stat.dead_neurons > 0 ? 'warning' : 'success'}">${stat.dead_neurons.toLocaleString()}</div>
                        </div>
                        <div class="metric-item" style="grid-column: span 2;">
                            <div class="metric-label">Gradient Norm (L2)</div>
                            <div class="metric-value ${gradNormClass}">${stat.grad_norm.toExponential(2)}</div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: ${Math.min(stat.grad_norm * 100, 100)}%; background: ${stat.grad_norm < 0.001 ? '#ef4444' : stat.grad_norm < 0.01 ? '#f59e0b' : '#10b981'};"></div>
                            </div>
                        </div>
                    </div>
                `;

                container.appendChild(card);
            });
        }

        function toggleAutoRefresh() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
                autoRefreshInterval = null;
                document.getElementById('autoRefreshStatus').textContent = 'OFF';
                document.querySelector('.refresh-btn').classList.remove('refresh-btn');
            } else {
                autoRefreshInterval = setInterval(() => {
                    if (currentJobId) loadStatistics();
                }, 2000);
                document.getElementById('autoRefreshStatus').textContent = 'ON (2s)';
                document.querySelector('.refresh-btn').classList.add('refresh-btn');
            }
        }

        function showLoading(show) {
            document.getElementById('loadingSection').style.display = show ? 'block' : 'none';
            document.getElementById('statsContainer').style.display = show ? 'none' : 'grid';
        }

        // Load available training jobs
        async function loadJobs() {
            try {
                const response = await fetch('/Training/History');
                const data = await response.json();
                
                const select = document.getElementById('jobSelect');
                select.innerHTML = '<option value="">Select Training Job</option>';
                
                if (data.jobs && data.jobs.length > 0) {
                    data.jobs.forEach(job => {
                        const option = document.createElement('option');
                        option.value = job.id;
                        option.textContent = `${job.name} (Epoch ${job.epoch}/${job.total_epochs})`;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Failed to load jobs:', error);
            }
        }

        // Initialize
        loadJobs();
    </script>
}
