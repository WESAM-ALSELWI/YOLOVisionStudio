@{
    ViewData["Title"] = "Prediction Explainability";
}

<style>
    .viz-container { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    .viz-card { background: var(--color-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px; }
    .viz-image { width: 100%; border-radius: 8px; margin-top: 10px; }
    .viz-controls { display: flex; gap: 10px; margin-bottom: 15px; flex-wrap: wrap; }
    .viz-controls select, .viz-controls input { flex: 1; min-width: 150px; }
    .heatmap-container { position: relative; display: inline-block; }
    .heatmap-overlay { position: absolute; top: 0; left: 0; opacity: 0.6; pointer-events: none; }
    .layer-selector { max-height: 200px; overflow-y: auto; }
    .layer-option { padding: 8px 12px; cursor: pointer; border-radius: 6px; margin: 2px 0; transition: background 0.2s; }
    .layer-option:hover { background: rgba(124, 58, 237, 0.1); }
    .layer-option.selected { background: rgba(124, 58, 237, 0.2); border-left: 3px solid var(--color-primary-start); }
    .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 15px; }
    .stat-item { background: rgba(0,0,0,0.3); padding: 10px; border-radius: 6px; }
    .stat-label { font-size: 0.75rem; color: var(--text-muted); }
    .stat-value { font-size: 1rem; font-weight: bold; color: var(--color-primary-end); }
</style>

<div class="page-header">
    <h1 class="page-title">Real Prediction Explainability</h1>
    <p class="page-subtitle">Grad-CAM & Attention Maps - See exactly what the model focuses on</p>
</div>

<div class="viz-controls">
    <input type="file" id="imageInput" accept="image/*" class="form-control" />
    <select id="modelSelect" class="form-control">
        <option value="yolo11n.pt">YOLO11n (Nano)</option>
        <option value="yolo11s.pt">YOLO11s (Small)</option>
        <option value="yolo11m.pt">YOLO11m (Medium)</option>
    </select>
    <select id="layerSelect" class="form-control">
        <option value="model.22">Final Conv Layer (model.22)</option>
        <option value="model.21">Penultimate Layer (model.21)</option>
        <option value="model.20">Layer 20</option>
        <option value="model.19">Layer 19</option>
        <option value="model.18">Layer 18</option>
    </select>
    <button class="btn btn-primary" onclick="generateGradCAM()">
        <i class="fas fa-fire mr-2"></i> Generate Grad-CAM
    </button>
    <button class="btn btn-success" onclick="generateAttentionMaps()">
        <i class="fas fa-eye mr-2"></i> Attention Maps
    </button>
</div>

<div id="resultsSection" style="display: none;">
    <div class="viz-container">
        <!-- Original Image -->
        <div class="viz-card">
            <h5><i class="fas fa-image mr-2"></i>Original Image</h5>
            <img id="originalImage" class="viz-image" alt="Original" />
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-label">Target Class</div>
                    <div class="stat-value" id="targetClass">-</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Confidence</div>
                    <div class="stat-value" id="confidence">-</div>
                </div>
            </div>
        </div>

        <!-- Grad-CAM Heatmap -->
        <div class="viz-card">
            <h5><i class="fas fa-fire mr-2"></i>Grad-CAM Heatmap</h5>
            <div class="heatmap-container">
                <img id="gradcamHeatmap" class="viz-image" alt="Grad-CAM" />
            </div>
            <p class="small text-muted mt-2">Red areas = high activation (model focuses here)</p>
        </div>

        <!-- Overlay -->
        <div class="viz-card">
            <h5><i class="fas fa-layer-group mr-2"></i>Overlay</h5>
            <img id="gradcamOverlay" class="viz-image" alt="Overlay" />
            <p class="small text-muted mt-2">Heatmap blended with original image</p>
        </div>

        <!-- Attention Maps -->
        <div class="viz-card">
            <h5><i class="fas fa-eye mr-2"></i>Multi-Scale Attention</h5>
            <div id="attentionMapsContainer" class="d-flex flex-wrap gap-2"></div>
            <img id="attentionOverlay" class="viz-image mt-2" alt="Attention Overlay" style="display: none;" />
        </div>
    </div>

    <!-- Layer Information -->
    <div class="viz-card mt-3">
        <h5><i class="fas fa-sitemap mr-2"></i>Analyzed Layer: <span id="analyzedLayer">-</span></h5>
        <p class="text-muted small">Grad-CAM shows which regions of the image contributed most to the prediction for the selected layer.</p>
    </div>
</div>

<div id="loadingSection" style="display: none; text-align: center; padding: 40px;">
    <div class="spinner-border text-primary" role="status">
        <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-3">Generating explanation... This may take a few seconds.</p>
</div>

@section Scripts {
    <script>
        let currentImageBase64 = null;

        document.getElementById('imageInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    currentImageBase64 = event.target.result.split(',')[1];
                    document.getElementById('originalImage').src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        async function generateGradCAM() {
            const modelPath = document.getElementById('modelSelect').value;
            const targetLayer = document.getElementById('layerSelect').value;

            if (!currentImageBase64) {
                alert('Please select an image first');
                return;
            }

            showLoading(true);

            try {
                const response = await fetch('/Visualization/GenerateGradCAM', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        modelPath: modelPath,
                        imageBase64: currentImageBase64,
                        targetLayer: targetLayer
                    })
                });

                const data = await response.json();

                if (data.originalImageBase64) {
                    document.getElementById('originalImage').src = 'data:image/jpeg;base64,' + data.originalImageBase64;
                    document.getElementById('gradcamHeatmap').src = 'data:image/jpeg;base64,' + data.heatmapBase64;
                    document.getElementById('gradcamOverlay').src = 'data:image/jpeg;base64,' + data.overlayBase64;
                    document.getElementById('targetClass').textContent = data.targetClass || '-';
                    document.getElementById('confidence').textContent = data.confidence ? (data.confidence * 100).toFixed(1) + '%' : '-';
                    document.getElementById('analyzedLayer').textContent = targetLayer;

                    document.getElementById('resultsSection').style.display = 'block';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Failed to generate Grad-CAM. Make sure the Python AI engine is running.');
            } finally {
                showLoading(false);
            }
        }

        async function generateAttentionMaps() {
            const modelPath = document.getElementById('modelSelect').value;

            if (!currentImageBase64) {
                alert('Please select an image first');
                return;
            }

            showLoading(true);

            try {
                const response = await fetch('/Visualization/GenerateAttentionMaps', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        modelPath: modelPath,
                        imageBase64: currentImageBase64
                    })
                });

                const data = await response.json();

                if (data.originalImageBase64) {
                    document.getElementById('originalImage').src = 'data:image/jpeg;base64,' + data.originalImageBase64;
                    document.getElementById('attentionOverlay').src = 'data:image/jpeg;base64,' + data.overlayBase64;
                    document.getElementById('attentionOverlay').style.display = 'block';

                    // Display individual attention maps
                    const container = document.getElementById('attentionMapsContainer');
                    container.innerHTML = '';
                    data.attentionMaps.forEach((map, idx) => {
                        const div = document.createElement('div');
                        div.innerHTML = `
                            <div style="text-align: center;">
                                <img src="data:image/jpeg;base64,${map.heatmap_base64}" 
                                     style="width: 100px; height: 100px; border-radius: 4px;" />
                                <p class="small text-muted mt-1">Layer ${map.layer_index}</p>
                            </div>
                        `;
                        container.appendChild(div);
                    });

                    document.getElementById('resultsSection').style.display = 'block';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Failed to generate attention maps. Make sure the Python AI engine is running.');
            } finally {
                showLoading(false);
            }
        }

        function showLoading(show) {
            document.getElementById('loadingSection').style.display = show ? 'block' : 'none';
            document.getElementById('resultsSection').style.display = show ? 'none' : 'block';
        }
    </script>
}
