/* ────────────────────────── THREE.JS BOOTSTRAP ────────────────────────── */
function initThree() {
  const container = document.getElementById('canvas-container');
  const canvas = document.getElementById('c');

  scene = new THREE.Scene();
  scene.background = new THREE.Color(0x000000);
  scene.fog = new THREE.FogExp2(0x000000, 0.00025);

  camera = new THREE.PerspectiveCamera(38, window.innerWidth / window.innerHeight, 1, 9000);
  camera.position.set(-300, 140, 1100);

  renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  if (typeof THREE.OrbitControls !== 'undefined') {
    controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.09; // Silky smooth deceleration
    controls.rotateSpeed = 0.8;
    controls.panSpeed = 1.2;
    controls.zoomSpeed = 1.3;
    controls.screenSpacePanning = true; // Natural 2D screen panning!
    controls.target.set(-100, 0, 0);

    // Default drag mode: left-click pans for effortless navigation!
    setControlsDragMode('pan');
  }

  // Lighting
  scene.add(new THREE.AmbientLight(0xffffff, 0.75));
  const l1 = new THREE.PointLight(0x3b82f6, 2.5, 2500);
  l1.position.set(-500, 500, 500);
  scene.add(l1);
  const l2 = new THREE.PointLight(0x10b981, 2.2, 2500);
  l2.position.set(1000, -300, 400);
  scene.add(l2);

  // Ground grid
  const grid = new THREE.GridHelper(5500, 90, 0x1e293b, 0x090d16);
  grid.position.y = -190;
  grid.material.transparent = true;
  grid.material.opacity = 0.35;
  scene.add(grid);

  raycaster = new THREE.Raycaster();
  mouse = new THREE.Vector2();

  // Optimized Mouse Events (No synchronous heavy raycasting on mousemove!)
  canvas.addEventListener('mousedown', () => { isUserDragging = true; document.getElementById('tip').style.display = 'none'; });
  window.addEventListener('mouseup', () => { isUserDragging = false; });
  canvas.addEventListener('touchstart', () => { isUserDragging = true; document.getElementById('tip').style.display = 'none'; }, { passive: true });
  window.addEventListener('touchend', () => { isUserDragging = false; });

  window.addEventListener('mousemove', e => {
    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
    mouseScreenPos.x = e.clientX;
    mouseScreenPos.y = e.clientY;
  });

  window.addEventListener('click', onSceneClick);
  window.addEventListener('resize', onWindowResize);
  window.addEventListener('keydown', onKeyDown);

  // Build default 10 Core Stages Network
  buildCurrentArchitecture();

  // Populate Bottom Real-Time Image Tray
  buildImageStatusTray();

  // Start live simulation for immediate visual responsiveness
  startLiveSimulation();

  // Render loop
  renderLoop();
}

/* ─── SMOOTH DRAG MODE TOGGLE (PAN VS ORBIT) ─── */
function setControlsDragMode(mode) {
  dragMode = mode;
  if (!controls) return;
  if (mode === 'pan') {
    // Left click = Pan, Right click = Rotate
    controls.mouseButtons = {
      LEFT: THREE.MOUSE.PAN,
      MIDDLE: THREE.MOUSE.DOLLY,
      RIGHT: THREE.MOUSE.ROTATE
    };
    document.getElementById('bDragMode').textContent = '✋ Pan';
    document.getElementById('dragModeBtn').textContent = '✋ Drag: Pan';
  } else {
    // Left click = Rotate, Right click = Pan
    controls.mouseButtons = {
      LEFT: THREE.MOUSE.ROTATE,
      MIDDLE: THREE.MOUSE.DOLLY,
      RIGHT: THREE.MOUSE.PAN
    };
    document.getElementById('bDragMode').textContent = '🔄 Orbit';
    document.getElementById('dragModeBtn').textContent = '🔄 Drag: Orbit';
  }
}

function toggleDragMode() {
  setControlsDragMode(dragMode === 'pan' ? 'orbit' : 'pan');
}

/* ─── SMOOTH KEYBOARD NAVIGATION ─── */
function onKeyDown(e) {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
  const k = e.key.toLowerCase();
  if (k === 'a' || k === 'arrowleft') panCamera(140, 0);
  else if (k === 'd' || k === 'arrowright') panCamera(-140, 0);
  else if (k === 'w' || k === 'arrowup') panCamera(0, 80);
  else if (k === 's' || k === 'arrowdown') panCamera(0, -80);
  else if (k === 'q' || k === '-') zoomCamera(180);
  else if (k === 'e' || k === '+' || k === '=') zoomCamera(-180);
  else if (k === 'r') resetCam();
  else if (k === ' ') toggleRot();
  else if (k >= '1' && k <= '9') {
    const idx = parseInt(k) - 1;
    if (CORE_10_STAGES[idx]) focusStageType(CORE_10_STAGES[idx].tag);
  } else if (k === '0' || k === 'f') {
    focusStageType('output');
  }
}

/* ─── SMOOTH CAMERA MOTION HELPERS ─── */
function panCamera(dx, dy) {
  if (!controls) return;
  const startTarget = controls.target.clone();
  const startCam = camera.position.clone();
  const endTarget = controls.target.clone().add(new THREE.Vector3(-dx, dy, 0));
  const endCam = camera.position.clone().add(new THREE.Vector3(-dx, dy, 0));

  smoothTransition(progress => {
    controls.target.lerpVectors(startTarget, endTarget, progress);
    camera.position.lerpVectors(startCam, endCam, progress);
  }, 350);
}

function zoomCamera(dz) {
  if (!controls) return;
  const dir = new THREE.Vector3().subVectors(controls.target, camera.position).normalize();
  const startCam = camera.position.clone();
  const endCam = camera.position.clone().addScaledVector(dir, -dz);

  smoothTransition(progress => {
    camera.position.lerpVectors(startCam, endCam, progress);
  }, 320);
}

function smoothTransition(fn, durationMs = 400) {
  const startTime = performance.now();
  function step(now) {
    const elapsed = now - startTime;
    const t = Math.min(1.0, elapsed / durationMs);
    const ease = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t; // easeInOutQuad
    fn(ease);
    if (t < 1.0) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

/* ────────────────────────── ARCHITECTURE SWITCHER ────────────────────────── */
function switchViewArchitecture(mode) {
  currentArchMode = mode;
  document.getElementById('btnMode9').classList.toggle('active', mode === '10core');
  document.getElementById('btnMode23').classList.toggle('active', mode === 'full23');

  activeStagesList = (mode === '10core') ? CORE_10_STAGES : FULL_23_STAGES;
  document.getElementById('bArchMode').textContent = (mode === '10core') ? '10 Core Stages' : 'Full (23 Layers)';
  document.getElementById('bLay').textContent = (mode === '10core') ? '10' : '23';

  buildCurrentArchitecture();
  resetCam();
}

function buildCurrentArchitecture(thumbsMap = {}) {
  buildNetworkScene(activeStagesList, thumbsMap);
}

/* ────────────────────────── BUILD NEURAL NETWORK SCENE ────────────────────────── */
function buildNetworkScene(stages, thumbsMap) {
  layerGroups.forEach(lg => scene.remove(lg.group));
  connectionMeshes.forEach(cm => scene.remove(cm));
  layerGroups = [];
  connectionMeshes = [];

  const spacing = (currentArchMode === '10core') ? CFG.LAYER_SPACING_10 : CFG.LAYER_SPACING_23;
  const N = stages.length;
  const totalW = (N - 1) * spacing;
  const startX = -totalW * 0.5;

  stages.forEach((stage, i) => {
    const x = startX + i * spacing;
    const lg = createLayerGroup(stage, x, thumbsMap[i] || []);
    scene.add(lg.group);
    layerGroups.push(lg);
  });

  // Build curved connection bundles between layer pairs
  for (let i = 0; i < layerGroups.length - 1; i++) {
    const conn = createLayerConnections(layerGroups[i], layerGroups[i + 1]);
    scene.add(conn);
    connectionMeshes.push(conn);
  }
}

/* ─── CREATE ONE LAYER GROUP WITH IN-NETWORK IMAGE STAGE PLANE ─── */
function createLayerGroup(stage, x, thumbs) {
  const group = new THREE.Group();
  group.position.set(x, 0, 0);

  const [rows, cols] = stage.grid || [3, 3];
  const tileMeshes = [];
  const edgeMeshes = [];

  const spatRatio = Math.max(0.4, Math.min(1.0, (stage.shape[2] || 64) / 320));
  const tileSize = CFG.TILE_SIZE * spatRatio;
  const tileGap = CFG.TILE_GAP * spatRatio;

  const totalGridH = rows * tileSize + (rows - 1) * tileGap;
  const totalGridW = cols * tileSize + (cols - 1) * tileGap;

  // 1. IN-NETWORK IMAGE STAGE PLANE
  const isFinal = (stage.tag === 'output');
  const isInput = (stage.tag === 'input');
  const imgSize = isFinal ? CFG.FINAL_IMAGE_SIZE : (isInput ? 110 : CFG.STAGE_IMAGE_SIZE);

  const cv = document.createElement('canvas');
  cv.width = 256; cv.height = 256;
  renderSingleImageStatusCanvasDirect(cv, stage.tag);

  const imgTex = new THREE.CanvasTexture(cv);
  const imgGeo = new THREE.PlaneGeometry(imgSize, imgSize);
  const imgMat = new THREE.MeshBasicMaterial({ map: imgTex, side: THREE.DoubleSide });
  const imagePlane = new THREE.Mesh(imgGeo, imgMat);
  imagePlane.rotation.y = 0;

  // Position image plane cleanly
  const imgPosX = (isInput || isFinal) ? 0 : (-totalGridW * 0.5 - imgSize * 0.5 - 12);
  imagePlane.position.set(imgPosX, 0, 6);

  imagePlane.userData = {
    isImageStage: true,
    layerIdx: stage.index,
    layerName: stage.name,
    type: stage.type,
    tag: stage.tag,
    shape: stage.shape,
    params: stage.params,
    desc: stage.desc,
    stageObj: stage,
    worldPos: new THREE.Vector3(x + imgPosX, 0, 6)
  };

  group.add(imagePlane);

  // Glowing Frame Border
  const imgEdgeGeo = new THREE.EdgesGeometry(imgGeo);
  const imgEdgeMat = new THREE.LineBasicMaterial({
    color: getTypeColor(stage.type),
    linewidth: isFinal ? 3 : 2,
    transparent: true,
    opacity: isFinal ? 0.95 : 0.8
  });
  const imgEdge = new THREE.LineSegments(imgEdgeGeo, imgEdgeMat);
  imgEdge.position.copy(imagePlane.position);
  group.add(imgEdge);
  edgeMeshes.push(imgEdge);

  // Save reference for live real-time WebSocket updates
  stageImageCanvases[stage.tag] = {
    canvas: cv,
    ctx: cv.getContext('2d'),
    texture: imgTex,
    mesh: imagePlane
  };

  // Header Sprite Label
  const stageInfo = STAGE_KNOWLEDGE[stage.tag] || { icon: '⚡', num: stage.index + 1 };
  const labelSubtitle = isFinal ? '🏆 Classified Output Image' : `${stage.shape[2]}×${stage.shape[3]} · Image Status`;
  const imgBadgeSprite = createTextSprite(`${stageInfo.icon} ${stage.name}`, labelSubtitle);
  imgBadgeSprite.position.set(imgPosX, imgSize * 0.5 + 15, 6);
  imgBadgeSprite.scale.set(imgSize * 1.35, 13, 1);
  group.add(imgBadgeSprite);

  // 2. FEATURE CHANNEL TILES GRID (Adjacent to image plane, omitted for final output)
  if (!isFinal && (!isInput || currentArchMode === 'full23')) {
    const gridOffsetX = isInput ? 0 : (imgSize * 0.5 + 12);

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const idx = r * cols + c;
        const px = gridOffsetX + c * (tileSize + tileGap) - (cols - 1) * 0.5 * (tileSize + tileGap);
        const py = (rows - 1) * 0.5 * (tileSize + tileGap) - r * (tileSize + tileGap);
        const pz = c * 3;

        const b64 = thumbs[idx];
        let mat;

        if (b64) {
          const key = b64.slice(0, 64);
          if (!texCache[key]) {
            const tex = new THREE.Texture();
            const img = new Image();
            img.onload = () => { tex.image = img; tex.needsUpdate = true; };
            img.src = 'data:image/jpeg;base64,' + b64;
            texCache[key] = tex;
          }
          mat = new THREE.MeshBasicMaterial({
            map: texCache[b64.slice(0, 64)],
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0.95
          });
        } else {
          const defTex = createSyntheticActivationTexture(stage.tag || 'conv', stage.index, idx);
          mat = new THREE.MeshBasicMaterial({
            map: defTex,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0.88
          });
        }

        const geo = new THREE.PlaneGeometry(tileSize, tileSize);
        const mesh = new THREE.Mesh(geo, mat);
        mesh.rotation.y = 0;
        mesh.position.set(px, py, pz);

        mesh.userData = {
          layerIdx: stage.index,
          layerName: stage.name,
          tileIdx: idx,
          shape: stage.shape,
          params: stage.params,
          type: stage.type,
          tag: stage.tag,
          desc: stage.desc,
          stageObj: stage,
          worldPos: new THREE.Vector3(x + px, py, pz)
        };

        group.add(mesh);
        tileMeshes.push(mesh);

        // Frame border
        const edgesGeo = new THREE.EdgesGeometry(geo);
        const edgeMat = new THREE.LineBasicMaterial({
          color: getTypeColor(stage.type),
          transparent: true,
          opacity: 0.4
        });
        const edgeLine = new THREE.LineSegments(edgesGeo, edgeMat);
        edgeLine.rotation.y = 0;
        edgeLine.position.set(px, py, pz);
        group.add(edgeLine);
        edgeMeshes.push(edgeLine);
      }
    }

    const chBadgeSprite = createTextSprite(`Channels (0..${stage.shape[1]-1})`, `Filters Grid`);
    chBadgeSprite.position.set(gridOffsetX, totalGridH * 0.5 + 14, 0);
    chBadgeSprite.scale.set(tileSize * cols * 1.3, 11, 1);
    group.add(chBadgeSprite);
  }

  return {
    group,
    imagePlane,
    tiles: tileMeshes,
    edges: edgeMeshes,
    meta: stage,
    x,
    tileSize,
    rows,
    cols,
    totalGridH,
    totalGridW
  };
}

/* ─── CREATE CURVED CONNECTION BUNDLES ─── */
function createLayerConnections(layerA, layerB) {
  const group = new THREE.Group();
  group.userData.lines = [];

  // Primary Ribbon between Image Stage Planes
  if (layerA.imagePlane && layerB.imagePlane) {
    const pA = new THREE.Vector3().copy(layerA.imagePlane.position).add(layerA.group.position);
    const pB = new THREE.Vector3().copy(layerB.imagePlane.position).add(layerB.group.position);
    const midX = (pA.x + pB.x) * 0.5;
    const cp = new THREE.Vector3(midX, (pA.y + pB.y) * 0.5 + 24, (pA.z + pB.z) * 0.5 + 28);

    const curve = new THREE.QuadraticBezierCurve3(pA, cp, pB);
    const geo = new THREE.BufferGeometry().setFromPoints(curve.getPoints(24));
    const isToFinal = (layerB.meta.tag === 'output');
    const mat = new THREE.LineBasicMaterial({
      color: isToFinal ? 0x10b981 : 0x38bdf8,
      linewidth: 3,
      transparent: true,
      opacity: 0.8,
      depthWrite: false
    });
    const mainLine = new THREE.Line(geo, mat);
    mainLine.userData = { baseOpacity: 0.8, color: mat.color.getHex(), phase: 0 };
    group.add(mainLine);
    group.userData.lines.push(mainLine);
  }

  // Multi-filament ribbons
  const tilesA = layerA.tiles.length ? layerA.tiles : [layerA.imagePlane];
  const tilesB = layerB.tiles.length ? layerB.tiles : [layerB.imagePlane];
  const count = Math.min(CFG.BEZIER_LINES_PER_PAIR, tilesA.length * tilesB.length);

  for (let i = 0; i < count; i++) {
    const tA = tilesA[i % tilesA.length];
    const tB = tilesB[(i * 3) % tilesB.length];
    if (!tA || !tB) continue;

    const pA = new THREE.Vector3().copy(tA.position).add(layerA.group.position);
    const pB = new THREE.Vector3().copy(tB.position).add(layerB.group.position);

    const midX = (pA.x + pB.x) * 0.5;
    const flareY = Math.sin(i * 1.3) * (layerA.totalGridH * 0.45 || 25);
    const flareZ = Math.abs(Math.cos(i * 1.1)) * (layerA.totalGridW * 0.4 || 25) + 12;

    const cp = new THREE.Vector3(midX, (pA.y + pB.y) * 0.5 + flareY, (pA.z + pB.z) * 0.5 + flareZ);
    const curve = new THREE.QuadraticBezierCurve3(pA, cp, pB);
    const geo = new THREE.BufferGeometry().setFromPoints(curve.getPoints(16));

    const r = Math.random();
    let col = 0x3b82f6;
    if (r > 0.65 && r <= 0.88) col = 0xf43f5e;
    else if (r > 0.88) col = 0xf8fafc;

    const baseOpacity = 0.12 + Math.random() * 0.22;
    const mat = new THREE.LineBasicMaterial({
      color: col,
      transparent: true,
      opacity: baseOpacity,
      depthWrite: false
    });

    const line = new THREE.Line(geo, mat);
    line.userData = {
      baseOpacity,
      color: col,
      isBlue: (col === 0x3b82f6),
      isRed: (col === 0xf43f5e),
      phase: Math.random() * Math.PI * 2
    };

    group.add(line);
    group.userData.lines.push(line);
  }

  return group;
}

/* ─── SYNTHETIC ACTIVATION TEXTURE (For Channel Grid) ─── */
function createSyntheticActivationTexture(tag, layerIdx, channelIdx) {
  const cv = document.createElement('canvas');
  cv.width = 64; cv.height = 64;
  const ctx = cv.getContext('2d');

  ctx.fillStyle = '#050505';
  ctx.fillRect(0, 0, 64, 64);

  if (tag === 'bn') {
    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 1.5;
    ctx.strokeRect(16, 20, 32, 28);
    ctx.strokeRect(20, 24, 24, 12);
  } else if (tag === 'silu') {
    ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 2;
    ctx.strokeRect(16, 20, 32, 28);
  } else if (tag === 'sppf') {
    const grad = ctx.createRadialGradient(32, 34, 4, 32, 34, 24);
    grad.addColorStop(0, '#f59e0b'); grad.addColorStop(1, '#050505');
    ctx.fillStyle = grad; ctx.fillRect(8, 8, 48, 48);
  } else if (tag === 'detect') {
    ctx.strokeStyle = '#e11d48'; ctx.lineWidth = 2;
    ctx.strokeRect(18, 22, 28, 24);
  } else {
    const freq = Math.max(1, 10 - Math.floor(layerIdx * 0.4));
    ctx.fillStyle = '#ffffff';
    for (let y = 4; y < 60; y += freq) {
      for (let x = 4; x < 60; x += freq) {
        const v = Math.sin(x * 0.2 + channelIdx) * Math.cos(y * 0.2 + layerIdx);
        if (v > 0.15) {
          ctx.fillStyle = `rgba(255, 255, 255, ${(v * 0.85).toFixed(2)})`;
          ctx.fillRect(x, y, freq * 0.8, freq * 0.8);
        }
      }
    }
    ctx.strokeStyle = 'rgba(255,255,255,0.7)';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(16, 20, 32, 28);
  }

  return new THREE.CanvasTexture(cv);
}

/* ─── REAL-TIME IMAGE STATUS UPDATES ACROSS 3D LAYERS ─── */
function updateInNetworkStageImage(tag, b64Image) {
  const item = stageImageCanvases[tag];
  if (!item) return;

  if (b64Image) {
    const img = new Image();
    img.onload = () => {
      item.ctx.drawImage(img, 0, 0, item.canvas.width, item.canvas.height);
      item.texture.needsUpdate = true;

      // Update tray canvas too
      const trayCanvas = document.getElementById(`trayCanvas_${tag}`);
      if (trayCanvas) {
        const tCtx = trayCanvas.getContext('2d');
        tCtx.drawImage(img, 0, 0, trayCanvas.width, trayCanvas.height);
      }
    };
    img.src = 'data:image/jpeg;base64,' + b64Image;
  } else {
    renderSingleImageStatusCanvasDirect(item.canvas, tag);
    item.texture.needsUpdate = true;
  }
}

/* ─── REAL WEBSOCKET FRAME & DETECTIONS HANDLER ─── */
function updateInputImage(b64, w, h, gt, pred) {
  if (!b64) return;
  currentBatchImageBase64 = b64;
  currentDetectionsList = pred || [];

  // Update Input Stage (raw photograph with ground truths)
  const itemIn = stageImageCanvases['input'];
  if (itemIn) {
    const img = new Image();
    img.onload = () => {
      itemIn.ctx.drawImage(img, 0, 0, itemIn.canvas.width, itemIn.canvas.height);
      const sx = itemIn.canvas.width / (w || 1);
      const sy = itemIn.canvas.height / (h || 1);

      (gt || []).forEach(b => {
        const [x, y, bw, bh] = b.bbox;
        itemIn.ctx.lineWidth = 3; itemIn.ctx.strokeStyle = '#22c55e';
        itemIn.ctx.strokeRect(x * sx, y * sy, bw * sx, bh * sy);
        itemIn.ctx.fillStyle = '#22c55e'; itemIn.ctx.font = 'bold 12px sans-serif';
        itemIn.ctx.fillText(b.name || '', x * sx + 2, y * sy - 4);
      });

      itemIn.texture.needsUpdate = true;
      const tcIn = document.getElementById('trayCanvas_input');
      if (tcIn) tcIn.getContext('2d').drawImage(itemIn.canvas, 0, 0, tcIn.width, tcIn.height);
    };
    img.src = 'data:image/jpeg;base64,' + b64;
  }

  // Update Final Output Stage (REAL output image with predicted objects & labels)
  const itemOut = stageImageCanvases['output'];
  if (itemOut) {
    const img2 = new Image();
    img2.onload = () => {
      itemOut.ctx.drawImage(img2, 0, 0, itemOut.canvas.width, itemOut.canvas.height);
      const sx = itemOut.canvas.width / (w || 1);
      const sy = itemOut.canvas.height / (h || 1);

      (pred || []).forEach(b => {
        const [x, y, bw, bh] = b.bbox;
        const col = (b.confidence > 0.75) ? '#10b981' : ((b.confidence > 0.5) ? '#eab308' : '#ef4444');
        itemOut.ctx.lineWidth = 3; itemOut.ctx.strokeStyle = col;
        itemOut.ctx.strokeRect(x * sx, y * sy, bw * sx, bh * sy);

        // Solid badge with object label and confidence score
        const labelText = `${b.name || 'object'} ${Math.round((b.confidence || 0) * 100)}%`;
        itemOut.ctx.font = 'bold 12px sans-serif';
        const txtWidth = itemOut.ctx.measureText(labelText).width;
        itemOut.ctx.fillStyle = col;
        itemOut.ctx.fillRect(x * sx, y * sy - 18, txtWidth + 8, 18);
        itemOut.ctx.fillStyle = '#000000';
        itemOut.ctx.fillText(labelText, x * sx + 4, y * sy - 4);
      });

      itemOut.texture.needsUpdate = true;
      const tcOut = document.getElementById('trayCanvas_output');
      if (tcOut) tcOut.getContext('2d').drawImage(itemOut.canvas, 0, 0, tcOut.width, tcOut.height);
    };
    img2.src = 'data:image/jpeg;base64,' + b64;
  }
}

