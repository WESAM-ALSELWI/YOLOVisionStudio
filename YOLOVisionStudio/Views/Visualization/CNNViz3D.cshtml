    drawUpsampledGridFeatures(ctxOut, 128);
    document.getElementById('isTransformTitle').textContent = '2. 2× Spatial Interpolation';
  } else if (tag === 'concat') {
    drawEdgeFilteredTruck(ctxIn, 128);
    drawConcatMerger(ctxOp);
    drawFusedDualChannelFeatures(ctxOut, 128);
    document.getElementById('isTransformTitle').textContent = '2. Channel-wise Concatenation';
  } else if (tag === 'detect') {
    drawFusedDualChannelFeatures(ctxIn, 128);
    drawAnchorGrid(ctxOp);
    drawDetectLogits(ctxOut, 128);
    document.getElementById('isTransformTitle').textContent = '2. DFL & Class Branches';
  } else if (tag === 'output') {
    drawSampleTruck(ctxIn, false, 128);
    drawNMSFilterAnimation(ctxOp);
    drawRealClassifiedFinalResult(ctxOut, 128);
    document.getElementById('isTransformTitle').textContent = '2. NMS IoU Filtering (0.45)';
  }
}

/* ─── REAL FINAL CLASSIFIED OUTPUT IMAGE RENDERING ─── */
function drawRealClassifiedFinalResult(ctx, size = 128) {
  const s = size / 128;
  // 1. Draw photographic scene background
  ctx.fillStyle = '#1e293b'; ctx.fillRect(0, 0, size, size);
  ctx.fillStyle = '#334155'; ctx.fillRect(0, 0, size, 65 * s);
  ctx.fillStyle = '#0f172a'; ctx.fillRect(0, 65 * s, size, 63 * s);
  ctx.fillStyle = '#020617';
  ctx.fillRect(40 * s, 50 * s, 48 * s, 30 * s);
  ctx.fillRect(48 * s, 38 * s, 32 * s, 16 * s);

  // 2. High-precision detected bounding boxes with classifications & confidence labels
  const detections = [
    { label: 'truck 96%',  col: '#10b981', x: 36 * s, y: 34 * s, w: 56 * s, h: 50 * s },
    { label: 'car 92%',    col: '#3b82f6', x: 8 * s,  y: 48 * s, w: 30 * s, h: 26 * s },
    { label: 'traffic 94%',col: '#eab308', x: 74 * s, y: 12 * s, w: 18 * s, h: 28 * s },
    { label: 'sign 89%',   col: '#f59e0b', x: 6 * s,  y: 38 * s, w: 16 * s, h: 26 * s },
    { label: 'road 91%',   col: '#06b6d4', x: 26 * s, y: 88 * s, w: 30 * s, h: 30 * s }
  ];

  detections.forEach(d => {
    ctx.lineWidth = 2.5 * s;
    ctx.strokeStyle = d.col;
    ctx.strokeRect(d.x, d.y, d.w, d.h);

    ctx.font = `bold ${Math.max(9, Math.round(10 * s))}px sans-serif`;
    const tw = ctx.measureText(d.label).width;
    ctx.fillStyle = d.col;
    ctx.fillRect(d.x, d.y - 14 * s, tw + 6 * s, 14 * s);
    ctx.fillStyle = '#000';
    ctx.fillText(d.label, d.x + 3 * s, d.y - 3 * s);
  });
}

function drawDetectLogits(ctx, size = 128) {
  drawAnchorGrid(ctx);
  const s = size / 128;
  const grad = ctx.createRadialGradient(64 * s, 64 * s, 4 * s, 64 * s, 64 * s, 45 * s);
  grad.addColorStop(0, '#e11d48'); grad.addColorStop(0.5, '#f59e0b'); grad.addColorStop(1, 'transparent');
  ctx.fillStyle = grad; ctx.fillRect(10 * s, 10 * s, 108 * s, 108 * s);
}

function drawNMSFilterAnimation(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.strokeStyle = '#64748b'; ctx.setLineDash([3, 3]);
  ctx.strokeRect(30, 30, 60, 55);
  ctx.strokeRect(40, 36, 54, 52);
  ctx.setLineDash([]);
  ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.5;
  ctx.strokeRect(36, 34, 56, 50);
  ctx.fillStyle = '#10b981'; ctx.font = 'bold 10px monospace'; ctx.textAlign = 'center';
  ctx.fillText('IoU Overlap > 0.45', 64, 106);
  ctx.fillText('Suppressed: 2 boxes', 64, 118);
}

/* ─── CANVAS DRAWING PRIMITIVES FOR IMAGE STATUS ─── */
function drawSampleTruck(ctx, withBoxes, size = 128) {
  const s = size / 128;
  ctx.fillStyle = '#1e293b'; ctx.fillRect(0, 0, size, size);
  ctx.fillStyle = '#334155'; ctx.fillRect(0, 0, size, 65 * s);
  ctx.fillStyle = '#0f172a'; ctx.fillRect(0, 65 * s, size, 63 * s);

  ctx.fillStyle = '#020617';
  ctx.fillRect(40 * s, 50 * s, 48 * s, 30 * s);
  ctx.fillRect(48 * s, 38 * s, 32 * s, 16 * s);

  if (withBoxes) {
    ctx.lineWidth = 2 * s; ctx.strokeStyle = '#ef4444'; ctx.strokeRect(36 * s, 34 * s, 56 * s, 50 * s);
    ctx.strokeStyle = '#3b82f6'; ctx.strokeRect(8 * s, 48 * s, 30 * s, 26 * s);
  }
}

function drawKernelGrid(ctx, weights) {
  const size = 30, startX = 19, startY = 19;
  for (let r = 0; r < 3; r++) {
    for (let c = 0; c < 3; c++) {
      const w = weights[r * 3 + c];
      ctx.fillStyle = w > 0 ? `rgba(59,130,246,${Math.min(1, Math.abs(w)*0.25)})` : (w < 0 ? `rgba(244,63,94,${Math.min(1, Math.abs(w)*0.25)})` : '#1e293b');
      ctx.fillRect(startX + c * size, startY + r * size, size - 2, size - 2);
      ctx.fillStyle = '#fff'; ctx.font = 'bold 11px monospace'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(w, startX + c * size + size*0.5 - 1, startY + r * size + size*0.5 - 1);
    }
  }
}

function drawEdgeFilteredTruck(ctx, size = 128) {
  const s = size / 128;
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, size, size);
  ctx.strokeStyle = '#60a5fa'; ctx.lineWidth = 2 * s;
  ctx.strokeRect(40 * s, 50 * s, 48 * s, 30 * s);
  ctx.strokeRect(48 * s, 38 * s, 32 * s, 16 * s);
  ctx.beginPath(); ctx.arc(52 * s, 80 * s, 6 * s, 0, Math.PI*2); ctx.stroke();
  ctx.beginPath(); ctx.arc(76 * s, 80 * s, 6 * s, 0, Math.PI*2); ctx.stroke();
}

function drawBellCurve(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2.5; ctx.beginPath();
  for (let x = 10; x <= 118; x++) {
    const norm = (x - 64) / 18;
    const y = 110 - Math.exp(-0.5 * norm * norm) * 85;
    if (x === 10) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  }
  ctx.stroke();
  ctx.fillStyle = '#64748b'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
  ctx.fillText('μ = 0.0, σ = 1.0', 64, 120);
}

function drawNormalizedFeatures(ctx, size = 128) {
  drawEdgeFilteredTruck(ctx, size);
  const imgData = ctx.getImageData(0, 0, size, size);
  for (let i = 0; i < imgData.data.length; i += 4) {
    if (imgData.data[i] > 80) {
      imgData.data[i] = 16; imgData.data[i+1] = 185; imgData.data[i+2] = 129;
    }
  }
  ctx.putImageData(imgData, 0, 0);
}

function drawSiLUCurve(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 2.5; ctx.beginPath();
  for (let x = 10; x <= 118; x++) {
    const rx = (x - 64) / 12;
    const silu = rx / (1 + Math.exp(-rx));
    const y = 80 - silu * 15;
    if (x === 10) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  }
  ctx.stroke();
  ctx.fillStyle = '#64748b'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
  ctx.fillText('f(x) = x · σ(x)', 64, 120);
}

function drawRectifiedFeatures(ctx, size = 128) {
  const s = size / 128;
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, size, size);
  ctx.strokeStyle = '#a855f7'; ctx.lineWidth = 3 * s;
  ctx.strokeRect(40 * s, 50 * s, 48 * s, 30 * s);
  ctx.strokeRect(48 * s, 38 * s, 32 * s, 16 * s);
}

function drawBottleneckFlow(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.strokeStyle = '#ec4899'; ctx.lineWidth = 2;
  ctx.strokeRect(15, 48, 26, 32);
  ctx.strokeRect(87, 48, 26, 32);
  ctx.beginPath(); ctx.moveTo(41, 64); ctx.lineTo(87, 64); ctx.stroke();
  ctx.beginPath(); ctx.arc(64, 40, 16, Math.PI, 0); ctx.stroke();
  ctx.fillStyle = '#fff'; ctx.font = '9px monospace'; ctx.textAlign = 'center';
  ctx.fillText('Split & Shortcut', 64, 98);
}

function drawPartLevelFeatures(ctx, size = 128) {
  const s = size / 128;
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, size, size);
  ctx.fillStyle = '#ec4899';
  ctx.fillRect(40 * s, 50 * s, 48 * s, 10 * s);
  ctx.fillRect(48 * s, 38 * s, 32 * s, 12 * s);
  ctx.beginPath(); ctx.arc(52 * s, 75 * s, 8 * s, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(76 * s, 75 * s, 8 * s, 0, Math.PI*2); ctx.fill();
}

function drawMultiScalePoolGrid(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.strokeStyle = '#f59e0b'; ctx.lineWidth = 1.5;
  ctx.strokeRect(14, 14, 100, 100);
  ctx.strokeStyle = '#38bdf8'; ctx.strokeRect(28, 28, 72, 72);
  ctx.strokeStyle = '#ec4899'; ctx.strokeRect(44, 44, 40, 40);
  ctx.fillStyle = '#fff'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
  ctx.fillText('5×5', 64, 52); ctx.fillText('9×9', 64, 38); ctx.fillText('13×13', 64, 22);
}

function drawMultiScaleContextHeatmap(ctx, size = 128) {
  const s = size / 128;
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, size, size);
  const grad = ctx.createRadialGradient(64 * s, 64 * s, 4 * s, 64 * s, 64 * s, 50 * s);
  grad.addColorStop(0, '#f59e0b'); grad.addColorStop(0.6, '#ec4899'); grad.addColorStop(1, 'transparent');
  ctx.fillStyle = grad; ctx.fillRect(8 * s, 8 * s, 112 * s, 112 * s);
}

function drawUpsampleGridLines(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.strokeStyle = '#a855f7'; ctx.lineWidth = 1.5;
  ctx.strokeRect(44, 44, 40, 40);
  ctx.setLineDash([4, 4]); ctx.strokeRect(20, 20, 88, 88); ctx.setLineDash([]);
  ctx.fillStyle = '#fff'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
  ctx.fillText('20×20 → 40×40 (2×)', 64, 118);
}

function drawUpsampledGridFeatures(ctx, size = 128) {
  const s = size / 128;
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, size, size);
  for (let y = 20 * s; y < 100 * s; y += 12 * s) {
    for (let x = 20 * s; x < 100 * s; x += 12 * s) {
      ctx.fillStyle = '#a855f7';
      ctx.fillRect(x, y, 10 * s, 10 * s);
    }
  }
}

function drawConcatMerger(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.fillStyle = '#3b82f6'; ctx.fillRect(20, 30, 40, 68);
  ctx.fillStyle = '#a855f7'; ctx.fillRect(68, 30, 40, 68);
  ctx.fillStyle = '#fff'; ctx.font = '10px monospace'; ctx.textAlign = 'center';
  ctx.fillText('C1', 40, 68); ctx.fillText('C2', 88, 68);
  ctx.fillText('Concat [C1 + C2]', 64, 116);
}

function drawFusedDualChannelFeatures(ctx, size = 128) {
  const s = size / 128;
  drawEdgeFilteredTruck(ctx, size);
  const grad = ctx.createRadialGradient(64 * s, 64 * s, 4 * s, 64 * s, 64 * s, 45 * s);
  grad.addColorStop(0, 'rgba(6,182,212,0.6)'); grad.addColorStop(1, 'transparent');
  ctx.fillStyle = grad; ctx.fillRect(10 * s, 10 * s, 108 * s, 108 * s);
}

function drawAnchorGrid(ctx) {
  ctx.fillStyle = '#030712'; ctx.fillRect(0, 0, 128, 128);
  ctx.strokeStyle = '#334155'; ctx.lineWidth = 1;
  for (let i = 16; i < 128; i += 16) {
    ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 128); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(0, i); ctx.lineTo(128, i); ctx.stroke();
  }
  ctx.strokeStyle = '#e11d48'; ctx.lineWidth = 2; ctx.strokeRect(40, 40, 48, 48);
}

/* ─── SCENE CLICK ─── */
function onSceneClick(e) {
  if (e.target.tagName === 'BUTTON' || e.target.closest('.stage-modal') || e.target.closest('.nav') || e.target.closest('.arch-ribbon') || e.target.closest('.image-tray') || e.target.closest('.nav-pad')) return;
  raycaster.setFromCamera(mouse, camera);
  const allClickables = layerGroups.flatMap(lg => [...lg.tiles, ...(lg.imagePlane ? [lg.imagePlane] : [])]);
  const intersects = raycaster.intersectObjects(allClickables);
  if (intersects.length > 0) {
    const u = intersects[0].object.userData;
    currentSelectedLayer = u.stageObj;
    updateInspectorWithLayer(u.stageObj);
    openStageDeepDive(u.tag);
  }
}

function updateInspectorWithLayer(stage) {
  const gn = gradNorms[stage.index];
  document.getElementById('inspName').textContent = `#${stage.index} ${stage.name}`;
  document.getElementById('inspType').textContent = stage.type;
  document.getElementById('inspShape').textContent = (stage.shape || []).join(' × ');
  document.getElementById('inspCh').textContent = stage.shape[1] + ' channels';
  document.getElementById('inspRes').textContent = `${stage.shape[2] || 640}×${stage.shape[3] || 640} px`;
  document.getElementById('inspParams').textContent = (stage.params || 0).toLocaleString();
  document.getElementById('inspGrad').textContent = gn != null ? (gn * 100).toFixed(2) + '%' : '–';
  document.getElementById('inspDesc').textContent = stage.desc || 'Feature transformation layer.';
}

function onWindowResize() {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
}

/* ─── CONTROLS & HELPERS ─── */
function toggleRot() {
  autoRotate = !autoRotate;
  if (controls) controls.autoRotate = autoRotate;
  const btn = document.getElementById('rotBtn');
  btn.classList.toggle('on', autoRotate);
  btn.textContent = autoRotate ? '⟳ Rotate' : '❙❙ Paused';
}

function resetCam() {
  if (controls) {
    smoothTransition(p => {
      camera.position.lerp(new THREE.Vector3(-300, 140, 1100), p);
      controls.target.lerp(new THREE.Vector3(-100, 0, 0), p);
    }, 450);
  }
}

function getTypeColor(type) {
  const t = (type || '').toLowerCase();
  if (t === 'output' || t.includes('result')) return 0x10b981; // emerald
  if (t.includes('c2f') || t.includes('csp')) return 0xec4899; // pink
  if (t.includes('sppf') || t.includes('pool')) return 0xf59e0b; // amber
  if (t.includes('upsample')) return 0xa855f7; // purple
  if (t.includes('concat')) return 0x06b6d4; // cyan
  if (t.includes('detect') || t.includes('head')) return 0xe11d48; // crimson
  if (t === 'bn' || t.includes('norm')) return 0x10b981; // emerald
  if (t === 'silu' || t.includes('act')) return 0x8b5cf6; // violet
  if (t === 'input') return 0x38bdf8; // cyan
  return 0x3b82f6; // blue conv default
}

function createTextSprite(line1, line2) {
  const cv = document.createElement('canvas');
  cv.width = 512; cv.height = 70;
  const ctx = cv.getContext('2d');
  ctx.font = 'bold 22px monospace';
  ctx.fillStyle = '#60a5fa'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText(line1, 256, 22);
  ctx.font = '14px monospace';
  ctx.fillStyle = '#64748b';
  ctx.fillText(line2, 256, 48);
  const tex = new THREE.CanvasTexture(cv);
  return new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, opacity: 0.85 }));
}

function setPhase(idx, cls) {
  if (_phase === idx) return;
  _phase = idx;
  document.querySelectorAll('.ph').forEach(el => { el.className = 'ph'; });
  const p = document.getElementById('ph' + idx);
  if (p) p.classList.add(cls);
}

function setBadge(text, cls) {
  const b = document.getElementById('wsBadge');
  b.textContent = text;
  b.className = 'wsbadge ' + cls;
}

/* ─── WEBSOCKET & LIVE STREAMING ─── */
function applyPipelineUpdates(pipeline) {
  if (!pipeline || !pipeline.length) return;
  setPhase(1, 'af');

  pipeline.forEach((stage, i) => {
    const lg = layerGroups[i];
    if (!lg) return;

    (stage.thumbs || []).forEach((b64, tIdx) => {
      if (!b64 || !lg.tiles[tIdx]) return;
      const key = b64.slice(0, 64);
      if (!texCache[key]) {
        const tex = new THREE.Texture();
        const img = new Image();
        img.onload = () => { tex.image = img; tex.needsUpdate = true; };
        img.src = 'data:image/jpeg;base64,' + b64;
        texCache[key] = tex;
      }
      lg.tiles[tIdx].material.map = texCache[key];
      lg.tiles[tIdx].material.needsUpdate = true;
    });
  });
}

function applyCoreStagesUpdates(coreStages) {
  if (!coreStages) return;
  Object.entries(coreStages).forEach(([tag, stage]) => {
    const b64 = stage.thumbs && stage.thumbs.length > 0 ? stage.thumbs[0] : (stage.image_base64 || null);
    updateInNetworkStageImage(tag, b64);

    const statusLbl = document.getElementById(`trayStatus_${tag}`);
    if (stage.shape && statusLbl) {
      statusLbl.textContent = `${stage.shape.slice(1).join('×')}`;
    }
  });
}

function applyGradNorms(gn) {
  if (!gn) return;
  const vals = Object.values(gn).map(Number);
  const mx = Math.max(...vals, 1e-9);
  gradNorms = {};
  Object.entries(gn).forEach(([k, v]) => { gradNorms[parseInt(k)] = v / mx; });

  setPhase(3, 'ab');
  setTimeout(() => setPhase(4, 'au'), 600);

  const barsContainer = document.getElementById('gbars');
  barsContainer.innerHTML = '';
  Object.keys(gn).sort((a, b) => a - b).forEach(k => {
    const val = (gn[k] || 0) / mx;
    const h = Math.max(3, Math.round(val * 100));
    const bar = document.createElement('div');
    bar.className = 'gbar-item';
    bar.style.height = h + '%';
    bar.style.background = val > 0.5 ? '#f43f5e' : (val > 0.25 ? '#fbbf24' : '#3b82f6');
    bar.title = `L${k}: ${(gn[k] || 0).toFixed(4)}`;
    barsContainer.appendChild(bar);
  });
}

function applyMetrics(m) {
  if (!m) return;
  if (m.epoch != null) {
    document.getElementById('mEp').textContent = `${m.epoch} / ${totalEpochs}`;
    const pct = Math.min(100, Math.round(m.epoch * 100 / (totalEpochs || 1)));
    document.getElementById('pf').style.width = pct + '%';
    document.getElementById('ptxt').textContent = `${pct}% completed`;
  }
  if (m.batch != null) document.getElementById('mBat').textContent = m.batch;
  if (m.box_loss != null) document.getElementById('mBox').textContent = Number(m.box_loss).toFixed(4);
  if (m.cls_loss != null) document.getElementById('mCls').textContent = Number(m.cls_loss).toFixed(4);
  if (m.map50 != null && m.map50 > 0) document.getElementById('mMap').textContent = Number(m.map50).toFixed(3);
  if (m.lr != null) document.getElementById('mLR').textContent = Number(m.lr).toExponential(2);
}

function connect(pythonJobId, epochs) {
  if (ws) { try { ws.close(); } catch {} ws = null; }
  if (!pythonJobId) return;

  totalEpochs = epochs || 100;
  setBadge('CONNECTING', 'b-idle');
  setPhase(0, 'af');

  ws = new WebSocket(`${PY_WS}/ws/training/${pythonJobId}`);
  ws.onopen = () => {
    setBadge('● LIVE STREAM', 'b-live');
    document.getElementById('bPhase').textContent = 'Live Training';
  };
  ws.onclose = () => setBadge('OFFLINE', 'b-idle');
  ws.onerror = () => setBadge('DISCONNECTED', 'b-err');

  ws.onmessage = ev => {
    let msg;
    try { msg = JSON.parse(ev.data); } catch { return; }

    if (msg.metrics) applyMetrics(msg.metrics);
    if (msg.pipeline && msg.pipeline.length) applyPipelineUpdates(msg.pipeline);
    if (msg.core_stages) applyCoreStagesUpdates(msg.core_stages);
    if (msg.grad_norms && Object.keys(msg.grad_norms).length) applyGradNorms(msg.grad_norms);
    if (msg.frame) updateInputImage(msg.frame.image_base64, msg.frame.width, msg.frame.height, msg.frame.gt, msg.frame.pred);
    if (msg.status === 'completed') setBadge('COMPLETED', 'b-idle');
    if (msg.status === 'failed') setBadge('FAILED', 'b-err');
  };
}

/* ─── JOB SELECTOR & INITIALIZATION ─── */
async function loadJobs() {
  const sels = [document.getElementById('jsel'), document.getElementById('ovSel')];
  try {
    const res = await fetch('/api/training/jobs');
    const jobs = await res.json();
    sels.forEach(sel => {
      if (!sel) return;
      sel.innerHTML = '<option value="">— Select Training Run —</option>';
      if (!jobs.length) {
        sel.innerHTML = '<option value="">No training jobs available</option>';
        return;
      }
      const running = jobs.filter(j => j.status === 'Running');
      const other = jobs.filter(j => j.status !== 'Running');
      [...running, ...other].forEach(j => {
        const opt = document.createElement('option');
        opt.value = j.pythonJobId || '';
        opt.dataset.epochs = j.totalEpochs || 100;
        opt.textContent = `${j.status === 'Running' ? '🟢' : '⚪'} ${j.name || 'Job ' + j.id} [${j.baseModel || 'YOLO'}] - Ep ${j.currentEpoch}/${j.totalEpochs}`;
        if (j.status === 'Running') opt.style.color = '#34d399';
        sel.appendChild(opt);
      });
      const autoPick = jobs.find(j => j.status === 'Running' && j.pythonJobId);
      if (autoPick) sels.forEach(s => { if (s) s.value = autoPick.pythonJobId || ''; });
    });
  } catch {}
}

function switchJob() {
  const sel = document.getElementById('jsel');
  if (!sel.value) return;
  const ep = parseInt(sel.options[sel.selectedIndex]?.dataset?.epochs) || 100;
  document.getElementById('ov').style.display = 'none';
  connect(sel.value, ep);
}

function startFromOverlay() {
  const sel = document.getElementById('ovSel');
  document.getElementById('ov').style.display = 'none';
  if (sel.value) {
    const ep = parseInt(sel.options[sel.selectedIndex]?.dataset?.epochs) || 100;
    document.getElementById('jsel').value = sel.value;
    connect(sel.value, ep);
  }
}

/* ─── AUTO BOOT ─── */
(async function boot() {
  initThree();
  await loadJobs();

  const jobParam = new URLSearchParams(window.location.search).get('job');
  if (jobParam) {
    document.getElementById('ov').style.display = 'none';
    try {
      const res = await fetch('/api/training/jobs');
      const jobs = await res.json();
      const found = jobs.find(j => j.pythonJobId === jobParam);
      document.getElementById('jsel').value = jobParam;
      connect(jobParam, found?.totalEpochs || 100);
    } catch {
      connect(jobParam, 100);
    }
  }
})();
</script>
