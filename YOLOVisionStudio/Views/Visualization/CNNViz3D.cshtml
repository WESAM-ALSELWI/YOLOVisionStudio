@{
    ViewData["Title"] = "YOLO 3D Neural Architecture & Image Flow Visualizer";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>YOLO — Live 3D Neural Network & Image Flow</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;background:#000;font-family:'Segoe UI',system-ui,sans-serif;color:#e2e8f0;overflow:hidden}
#canvas-container{position:fixed;inset:0;width:100%;height:100%;background:#000}
#c{display:block;width:100%;height:100%;cursor:grab}
#c:active{cursor:grabbing}

/* ─── TOP NAVIGATION ─── */
.nav{position:fixed;top:0;left:0;right:0;height:46px;background:rgba(5,5,12,.94);
  border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;
  padding:0 14px;gap:10px;z-index:70;backdrop-filter:blur(14px)}
.logo{font-size:.9rem;font-weight:900;color:#fff;letter-spacing:.02em;display:flex;align-items:center;gap:6px}
.logo-badge{background:linear-gradient(135deg,#3b82f6,#8b5cf6);color:#fff;font-size:.65rem;padding:2px 7px;border-radius:4px;font-weight:800}
.logo span{color:#60a5fa}
.vsep{width:1px;height:20px;background:rgba(255,255,255,.12)}
.jsel{background:rgba(255,255,255,.06);border:1px solid rgba(59,130,246,.35);color:#e2e8f0;
  padding:4px 10px;border-radius:6px;font-size:.76rem;min-width:210px;outline:none}
.wsbadge{padding:3px 9px;border-radius:20px;font-size:.65rem;font-weight:800;letter-spacing:.03em}
.b-idle{background:rgba(107,114,128,.2);color:#9ca3af;border:1px solid rgba(107,114,128,.35)}
.b-live{background:rgba(16,185,129,.18);color:#34d399;border:1px solid rgba(16,185,129,.5);
  animation:blv .9s ease-in-out infinite alternate}
.b-err{background:rgba(239,68,68,.18);color:#f87171;border:1px solid rgba(239,68,68,.4)}
@@keyframes blv{from{box-shadow:0 0 4px rgba(16,185,129,.3)}to{box-shadow:0 0 16px rgba(16,185,129,.6)}}
.nbtn{padding:4px 10px;border-radius:6px;font-size:.73rem;font-weight:600;cursor:pointer;
  border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.05);color:#cbd5e1;
  transition:all .18s;text-decoration:none;display:inline-flex;align-items:center;gap:5px}
.nbtn:hover{background:rgba(59,130,246,.15);border-color:rgba(59,130,246,.45);color:#93c5fd}
.nbtn.on{background:rgba(59,130,246,.25);border-color:#3b82f6;color:#bfdbfe}
.mode-pill-group{display:inline-flex;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:6px;padding:2px}
.mode-pill{padding:3px 8px;border-radius:4px;font-size:.68rem;font-weight:700;border:none;background:none;color:#94a3b8;cursor:pointer;transition:all .15s}
.mode-pill.active{background:#2563eb;color:#fff}

/* ─── 10 STAGES RIBBON (Input -> Conv -> ... -> Detect -> Final Result) ─── */
.arch-ribbon{position:fixed;top:46px;left:0;right:0;height:36px;background:rgba(2,4,10,.94);
  border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;
  padding:0 12px;gap:6px;z-index:65;overflow-x:auto;backdrop-filter:blur(10px)}
.arch-ribbon::-webkit-scrollbar{display:none}
.arch-tag{font-size:.6rem;font-weight:900;color:#64748b;text-transform:uppercase;letter-spacing:.08em;margin-right:4px;white-space:nowrap}
.arch-pill{padding:4px 10px;border-radius:15px;font-size:.69rem;font-weight:700;cursor:pointer;
  border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:#94a3b8;
  white-space:nowrap;transition:all .2s;display:inline-flex;align-items:center;gap:4px}
.arch-pill:hover{background:rgba(59,130,246,.15);border-color:#3b82f6;color:#e2e8f0;transform:translateY(-1px)}
.arch-pill.active{background:linear-gradient(135deg,rgba(59,130,246,.28),rgba(139,92,246,.28));
  border-color:#60a5fa;color:#fff;box-shadow:0 0 12px rgba(96,165,250,.4)}
.arch-pill.final-highlight{border-color:rgba(16,185,129,.5);color:#34d399}
.arch-pill.final-highlight.active{background:linear-gradient(135deg,rgba(16,185,129,.3),rgba(59,130,246,.3));border-color:#10b981;box-shadow:0 0 14px rgba(16,185,129,.5)}

/* ─── PHASE STRIP ─── */
.phstrip{position:fixed;top:82px;left:0;right:0;height:26px;background:rgba(3,3,8,.85);
  border-bottom:1px solid rgba(255,255,255,.05);display:flex;z-index:60;backdrop-filter:blur(8px)}
.ph{flex:1;display:flex;align-items:center;justify-content:center;gap:5px;
  font-size:.62rem;font-weight:700;color:#374151;transition:all .35s;
  border-right:1px solid rgba(255,255,255,.04)}
.ph:last-child{border-right:none}
.ph.af{color:#60a5fa;background:rgba(59,130,246,.1);text-shadow:0 0 10px rgba(96,165,250,.6)}
.ph.ab{color:#f43f5e;background:rgba(244,63,94,.1);text-shadow:0 0 10px rgba(244,63,94,.6)}
.ph.au{color:#34d399;background:rgba(16,185,129,.1);text-shadow:0 0 10px rgba(52,211,153,.6)}

/* ─── LEFT HUD: LIVE METRICS ─── */
.hud-left{position:fixed;top:118px;left:12px;width:190px;background:rgba(5,5,14,.9);
  border:1px solid rgba(59,130,246,.25);border-radius:12px;padding:12px;z-index:50;
  backdrop-filter:blur(14px);box-shadow:0 8px 30px rgba(0,0,0,.6)}
.hud-hd{font-size:.58rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;
  color:#60a5fa;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between}
.ldot{width:6px;height:6px;border-radius:50%;background:#10b981;animation:ld 1.4s ease-in-out infinite}
@@keyframes ld{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.2;transform:scale(1.3)}}
.mr{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px;font-size:.72rem}
.mk{color:#475569}.mv{font-weight:700;font-family:monospace;color:#f1f5f9}
.mv.g{color:#34d399}.mv.w{color:#fbbf24}.mv.r{color:#f87171}
.pb{height:5px;background:rgba(255,255,255,.07);border-radius:3px;overflow:hidden;margin:8px 0 3px}
.pf{height:100%;background:linear-gradient(90deg,#3b82f6,#06b6d4);border-radius:3px;transition:width .6s}
.ptxt{font-size:.58rem;color:#475569;text-align:center}
.sep{height:1px;background:rgba(255,255,255,.07);margin:9px 0}
.hud-title{font-size:.58rem;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
.gbars{display:flex;align-items:flex-end;gap:1.5px;height:32px;margin-top:4px}
.gbar-item{flex:1;min-width:2px;border-radius:1px 1px 0 0;transition:height .3s}
.gbarlbl{display:flex;justify-content:space-between;font-size:.54rem;color:#334155;margin-top:3px}

/* ─── RIGHT HUD: ARCHITECTURE INSPECTOR ─── */
.hud-right{position:fixed;top:118px;right:12px;width:240px;background:rgba(5,5,14,.9);
  border:1px solid rgba(139,92,246,.25);border-radius:12px;padding:12px;z-index:50;
  backdrop-filter:blur(14px);box-shadow:0 8px 30px rgba(0,0,0,.6);max-height:calc(100vh - 280px);overflow-y:auto}
.hud-right::-webkit-scrollbar{width:4px}
.hud-right::-webkit-scrollbar-thumb{background:#334155;border-radius:2px}
.rh-hd{font-size:.58rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#a78bfa;margin-bottom:6px}
.legend-box{display:flex;flex-direction:column;gap:5px;margin-bottom:10px;font-size:.66rem}
.leg-row{display:flex;align-items:center;gap:7px;color:#94a3b8}
.leg-line{width:16px;height:3px;border-radius:2px}
.leg-blue{background:#3b82f6;box-shadow:0 0 6px rgba(59,130,246,.8)}
.leg-red{background:#f43f5e;box-shadow:0 0 6px rgba(244,63,94,.8)}
.leg-white{background:#f8fafc;box-shadow:0 0 6px rgba(248,250,252,.6)}

.insp-box{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:9px;margin-top:6px}
.insp-name{font-weight:800;font-size:.78rem;color:#60a5fa;margin-bottom:4px}
.insp-row{display:flex;justify-content:space-between;font-size:.67rem;margin-bottom:3px}
.insp-k{color:#64748b}.insp-v{color:#f1f5f9;font-family:monospace;font-weight:600}
.insp-btn{width:100%;margin-top:8px;padding:7px;border-radius:6px;background:linear-gradient(135deg,#2563eb,#7c3aed);border:none;color:#fff;font-weight:700;font-size:.72rem;cursor:pointer;transition:transform .15s}
.insp-btn:hover{transform:scale(1.02)}

/* ─── SMOOTH NAVIGATION FLOATING CONTROLS (BOTTOM RIGHT) ─── */
.nav-pad{position:fixed;bottom:120px;right:14px;background:rgba(5,5,15,.9);
  border:1px solid rgba(59,130,246,.35);border-radius:12px;padding:8px;z-index:65;
  box-shadow:0 10px 30px rgba(0,0,0,.7);backdrop-filter:blur(14px);display:flex;flex-direction:column;gap:6px}
.nav-pad-row{display:flex;gap:5px;justify-content:center}
.np-btn{width:28px;height:28px;border-radius:6px;border:1px solid rgba(255,255,255,.12);
  background:rgba(255,255,255,.06);color:#cbd5e1;font-size:.8rem;font-weight:800;
  display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;user-select:none}
.np-btn:hover{background:rgba(59,130,246,.3);border-color:#3b82f6;color:#fff;transform:scale(1.08)}
.np-btn:active{transform:scale(0.95)}
.np-label{font-size:.56rem;font-weight:800;color:#94a3b8;text-align:center;text-transform:uppercase;letter-spacing:.05em;margin-top:2px}

/* ─── REAL-TIME IMAGE STATUS FLOW TRAY (BOTTOM DOCK) ─── */
.image-tray{position:fixed;bottom:36px;left:0;right:0;background:rgba(3,5,12,.94);
  border-top:1px solid rgba(59,130,246,.3);z-index:58;padding:8px 14px 6px;backdrop-filter:blur(16px);
  box-shadow:0 -10px 30px rgba(0,0,0,.7);transition:transform .3s ease}
.image-tray.collapsed{transform:translateY(calc(100% - 30px))}
.tray-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;cursor:pointer}
.tray-title{font-size:.74rem;font-weight:800;color:#60a5fa;display:flex;align-items:center;gap:6px;letter-spacing:.03em;text-transform:uppercase}
.tray-toggle-btn{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#cbd5e1;padding:2px 8px;border-radius:4px;font-size:.66rem;font-weight:700;cursor:pointer}
.tray-grid{display:grid;grid-template-columns:repeat(10, minmax(130px, 1fr));gap:8px;overflow-x:auto;padding-bottom:4px}
.tray-grid::-webkit-scrollbar{height:4px}
.tray-grid::-webkit-scrollbar-thumb{background:#334155;border-radius:2px}
.tray-card{background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.08);border-radius:8px;
  padding:6px;cursor:pointer;transition:all .18s;position:relative;display:flex;flex-direction:column}
.tray-card:hover{background:rgba(59,130,246,.12);border-color:#3b82f6;transform:translateY(-2px)}
.tray-card.active{border-color:#60a5fa;background:rgba(59,130,246,.18);box-shadow:0 0 12px rgba(96,165,250,.35)}
.tray-card.final-card{border-color:rgba(16,185,129,.35);background:rgba(16,185,129,.05)}
.tray-card.final-card.active{border-color:#10b981;box-shadow:0 0 14px rgba(16,185,129,.4)}
.tc-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px}
.tc-title{font-size:.66rem;font-weight:800;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tc-badge{font-size:.52rem;padding:1px 5px;border-radius:3px;font-weight:700;text-transform:uppercase}
.tc-canvas-wrap{width:100%;aspect-ratio:1;border-radius:5px;overflow:hidden;background:#000;
  border:1px solid rgba(255,255,255,.08);margin-bottom:4px;position:relative}
.tc-canvas-wrap canvas{width:100%;height:100%;object-fit:cover;display:block}
.tc-role{font-size:.56rem;color:#64748b;line-height:1.2;height:24px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tc-status{font-size:.54rem;font-family:monospace;color:#38bdf8;margin-top:2px;font-weight:600}

/* ─── DEEP-DIVE STAGE MODAL (Image Status + Dual Explanations + Final Detections) ─── */
.stage-modal{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:95;display:none;
  align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(8px)}
.sm-content{background:#080b14;border:1px solid rgba(59,130,246,.4);border-radius:14px;
  width:100%;max-width:880px;max-height:92vh;overflow-y:auto;padding:24px;box-shadow:0 20px 60px rgba(0,0,0,.8)}
.sm-content::-webkit-scrollbar{width:6px}
.sm-content::-webkit-scrollbar-thumb{background:#334155;border-radius:3px}
.sm-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;border-bottom:1px solid rgba(255,255,255,.08);padding-bottom:12px}
.sm-title{font-size:1.25rem;font-weight:900;color:#fff;display:flex;align-items:center;gap:8px}
.sm-badge{font-size:.68rem;padding:3px 9px;border-radius:12px;font-weight:800;text-transform:uppercase}
.sm-close{background:none;border:none;color:#64748b;font-size:1.4rem;cursor:pointer;padding:4px}
.sm-close:hover{color:#fff}

.mode-toggle{display:inline-flex;background:rgba(255,255,255,.06);padding:3px;border-radius:8px;border:1px solid rgba(255,255,255,.1)}
.mode-btn{padding:5px 14px;border-radius:6px;border:none;background:none;color:#94a3b8;font-size:.74rem;font-weight:700;cursor:pointer;transition:all .18s}
.mode-btn.active{background:#2563eb;color:#fff;box-shadow:0 0 10px rgba(37,99,235,.5)}

.image-status-section{margin:18px 0;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:16px}
.is-title{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#38bdf8;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.is-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px}
.is-card{background:rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:10px;text-align:center}
.is-card-title{font-size:.72rem;font-weight:700;color:#cbd5e1;margin-bottom:6px}
.is-img-wrap{aspect-ratio:1;border-radius:6px;overflow:hidden;background:#030712;display:flex;align-items:center;justify-content:center;margin-bottom:8px;border:1px solid rgba(255,255,255,.1)}
.is-img-wrap canvas, .is-img-wrap img{width:100%;height:100%;object-fit:cover;display:block}
.is-card-desc{font-size:.66rem;color:#64748b;line-height:1.4;text-align:left}

/* Final Detections Table */
.det-table-box{margin-top:14px;background:#030712;border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:12px;display:none}
.dt-head{font-size:.74rem;font-weight:800;color:#34d399;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
.dt-list{display:flex;flex-direction:column;gap:6px;max-height:180px;overflow-y:auto}
.dt-item{display:flex;align-items:center;justify-content:space-between;padding:5px 8px;border-radius:5px;background:rgba(255,255,255,.03);font-size:.72rem}
.dt-pill{padding:2px 7px;border-radius:4px;font-weight:800;font-size:.62rem;color:#fff}

.sm-explain-box{background:rgba(30,41,59,.4);border-left:4px solid #3b82f6;border-radius:0 8px 8px 0;padding:14px;margin-top:14px}
.sm-exp-hd{font-size:.78rem;font-weight:800;color:#93c5fd;margin-bottom:6px}
.sm-exp-body{font-size:.82rem;line-height:1.6;color:#cbd5e1}
.sm-math-box{background:#000;border:1px solid rgba(255,255,255,.1);border-radius:6px;padding:10px;margin-top:10px;font-family:monospace;font-size:.78rem;color:#38bdf8;overflow-x:auto}

/* ─── HOVER TOOLTIP ─── */
.tip{position:fixed;background:rgba(2,2,10,.96);border:1.5px solid #3b82f6;
  border-radius:9px;padding:10px 14px;min-width:180px;font-size:.72rem;display:none;
  z-index:90;pointer-events:none;backdrop-filter:blur(10px);box-shadow:0 0 20px rgba(59,130,246,.4)}
.tipname{color:#60a5fa;font-weight:800;margin-bottom:5px;font-size:.82rem}
.tipr{display:flex;justify-content:space-between;margin-bottom:3px}
.tipk{color:#64748b}.tipv{color:#f1f5f9;font-family:monospace;font-weight:700}

/* ─── BOTTOM BAR ─── */
.bot{position:fixed;bottom:0;left:0;right:0;height:36px;background:rgba(5,5,12,.94);
  border-top:1px solid rgba(255,255,255,.06);display:flex;align-items:center;
  padding:0 14px;gap:18px;font-size:.68rem;z-index:60;backdrop-filter:blur(10px)}
.bk{color:#475569;text-transform:uppercase;font-size:.58rem;letter-spacing:.04em;margin-right:4px}
.bv{font-family:monospace;font-weight:700;color:#cbd5e1}

/* ─── OVERLAY ─── */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.92);display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:16px;z-index:100;backdrop-filter:blur(6px)}
.ovico{font-size:3.8rem;filter:drop-shadow(0 0 24px rgba(59,130,246,.6))}
.ovtit{font-size:1.45rem;font-weight:900;color:#fff;text-align:center;letter-spacing:.02em}
.ovsub{font-size:.88rem;color:#64748b;max-width:440px;text-align:center;line-height:1.6}
.ovsub strong{color:#60a5fa}
.ovsel{background:rgba(255,255,255,.06);border:1px solid rgba(59,130,246,.5);color:#e2e8f0;
  padding:10px 16px;border-radius:10px;font-size:.9rem;min-width:300px;outline:none}
.ovbtn{padding:12px 38px;border-radius:10px;background:linear-gradient(135deg,#2563eb,#7c3aed);
  color:#fff;font-size:1rem;font-weight:800;cursor:pointer;border:none;
  box-shadow:0 0 32px rgba(59,130,246,.5);transition:all .18s}
.ovbtn:hover{transform:scale(1.04);box-shadow:0 0 45px rgba(59,130,246,.75)}
.ovnote{font-size:.76rem;color:#475569}
.ovnote a{color:#60a5fa;text-decoration:none}
</style>
<!-- Three.js + OrbitControls (Local offline first, CDN fallback) -->
<script src="/lib/three/three.min.js"></script>
<script src="/lib/three/OrbitControls.js"></script>
<script>
  if (typeof THREE === 'undefined') {
    document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>');
    document.write('<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"><\/script>');
  }
</script>
</head>
<body>
<div id="canvas-container">
  <canvas id="c"></canvas>
</div>

<!-- TOP NAV -->
<div class="nav">
  <div class="logo">
    <div class="logo-badge">YOLO 11</div>
    YOLO<span>Vision</span> 3D Studio
  </div>
  <div class="vsep"></div>

  <!-- 10 STAGES VS FULL 23 LAYERS TOGGLE -->
  <div class="mode-pill-group">
    <button class="mode-pill active" id="btnMode9" onclick="switchViewArchitecture('10core')">🌟 10 Core Stages</button>
    <button class="mode-pill" id="btnMode23" onclick="switchViewArchitecture('full23')">🔬 Full (23 Layers)</button>
  </div>

  <div class="vsep"></div>
  <select class="jsel" id="jsel" onchange="switchJob()"><option>Loading training jobs…</option></select>
  <span class="wsbadge b-idle" id="wsBadge">IDLE (DEMO)</span>

  <!-- DUAL EXPLAINER MODE IN TOP NAV -->
  <div class="mode-pill-group" style="margin-left:6px">
    <button class="mode-pill active" id="navBtnBeg" onclick="setGlobalExplainerMode('beginner')">🎓 Beginner</button>
    <button class="mode-pill" id="navBtnExp" onclick="setGlobalExplainerMode('expert')">🔬 AI Expert</button>
  </div>

  <div style="margin-left:auto;display:flex;gap:7px">
    <!-- Smooth Navigation Drag Mode Button -->
    <button class="nbtn on" id="dragModeBtn" onclick="toggleDragMode()">✋ Drag: Pan</button>
    <button class="nbtn on" id="simBtn" onclick="toggleSimulation()">▶ Simulation</button>
    <button class="nbtn on" id="btnTray" onclick="toggleImageTray()">🖼️ Image Flow</button>
    <button class="nbtn on" id="rotBtn" onclick="toggleRot()">⟳ Rotate</button>
    <button class="nbtn" onclick="resetCam()">⊞ Reset View</button>
    <a class="nbtn" href="/Training/History">← History</a>
    <a class="nbtn" href="/Training/Wizard">+ Train</a>
  </div>
</div>

<!-- 10 CORE ARCHITECTURAL STAGES RIBBON (Input -> Processing -> Output Result) -->
<div class="arch-ribbon" id="archRibbon">
  <span class="arch-tag">YOLO Stages:</span>
  <button class="arch-pill active" onclick="focusStageType('all')">🌐 All Network</button>
  <button class="arch-pill" onclick="focusStageType('input')">📷 1. Input Image</button>
  <button class="arch-pill" onclick="focusStageType('conv')">⚡ 2. Convolution (Conv)</button>
  <button class="arch-pill" onclick="focusStageType('bn')">⚖️ 3. Batch Normalization (BN)</button>
  <button class="arch-pill" onclick="focusStageType('silu')">📈 4. Activation (SiLU)</button>
