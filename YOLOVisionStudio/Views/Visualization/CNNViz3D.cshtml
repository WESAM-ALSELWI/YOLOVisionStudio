/* ─── RENDER LIVE IMAGE STATUS CANVAS PREVIEWS ─── */
function renderSingleImageStatusCanvas(canvasId, tag) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  renderSingleImageStatusCanvasDirect(canvas, tag);
}

function renderSingleImageStatusCanvasDirect(canvas, tag) {
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = '#05070f';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  if (tag === 'input') {
    drawSampleTruck(ctx, false, canvas.width);
  } else if (tag === 'conv') {
    drawEdgeFilteredTruck(ctx, canvas.width);
  } else if (tag === 'bn') {
    drawNormalizedFeatures(ctx, canvas.width);
  } else if (tag === 'silu') {
    drawRectifiedFeatures(ctx, canvas.width);
  } else if (tag === 'c2f') {
    drawPartLevelFeatures(ctx, canvas.width);
  } else if (tag === 'sppf') {
    drawMultiScaleContextHeatmap(ctx, canvas.width);
  } else if (tag === 'upsample') {
    drawUpsampledGridFeatures(ctx, canvas.width);
  } else if (tag === 'concat') {
    drawFusedDualChannelFeatures(ctx, canvas.width);
  } else if (tag === 'detect') {
    drawDetectLogits(ctx, canvas.width);
  } else if (tag === 'output') {
    drawRealClassifiedFinalResult(ctx, canvas.width);
  }
}

/* ─── LIVE SIMULATION ENGINE (When training is idle) ─── */
let _simPulseStep = 0;
function startLiveSimulation() {
  if (liveSimulationTimer) clearInterval(liveSimulationTimer);
  liveSimulationTimer = setInterval(() => {
    if (!simulationRunning) return;
    _simPulseStep = (_simPulseStep + 1) % 10;
    const stages = ['input', 'conv', 'bn', 'silu', 'c2f', 'sppf', 'upsample', 'concat', 'detect', 'output'];
    const curTag = stages[_simPulseStep];

    const card = document.getElementById(`trayCard_${curTag}`);
    if (card) {
      card.style.borderColor = STAGE_KNOWLEDGE[curTag].color;
      setTimeout(() => {
        if (!card.classList.contains('active')) card.style.borderColor = 'rgba(255,255,255,0.08)';
      }, 380);
    }

    const item = stageImageCanvases[curTag];
    if (item && item.mesh) {
      item.mesh.scale.set(1.05, 1.05, 1.0);
      setTimeout(() => {
        item.mesh.scale.set(1.0, 1.0, 1.0);
      }, 350);
    }
  }, 650);
}

function toggleSimulation() {
  simulationRunning = !simulationRunning;
  const btn = document.getElementById('simBtn');
  btn.classList.toggle('on', simulationRunning);
  btn.textContent = simulationRunning ? '▶ Simulation' : '❙❙ Paused';
}

/* ─── OPTIMIZED RENDER & ANIMATION LOOP (SOLID 60 FPS) ─── */
let _pulseClock = 0;
function renderLoop() {
  requestAnimationFrame(renderLoop);

  const now = performance.now();
  const dt = Math.min((now - (renderLoop._last || now)) * 0.001, 0.05);
  renderLoop._last = now;
  _pulseClock += dt;

  if (controls) {
    controls.update();
  }

  // Throttled Raycast Hover Check (Every ~50ms, never when dragging)
  if (!isUserDragging && (now - lastRaycastTime > 48)) {
    lastRaycastTime = now;
    performHoverRaycast();
  }

  // Animate connection lines
  if (showLinks) {
    connectionMeshes.forEach((cm, gi) => {
      (cm.userData.lines || []).forEach(line => {
        const u = line.userData;
        const wave = Math.sin(_pulseClock * 3 + u.phase + gi * 0.5);
        line.material.opacity = u.baseOpacity * (0.8 + wave * 0.45);
      });
    });
  }

  // Pulse edge glow from real gradients
  layerGroups.forEach(lg => {
    const gn = gradNorms[lg.meta.index] || 0;
    const pulse = Math.sin(_pulseClock * 4 + lg.meta.index);
    const isFiltered = (activeStageFilter === 'all' || lg.meta.tag === activeStageFilter);

    lg.edges.forEach(edge => {
      if (edge.material) {
        if (!isFiltered) {
          edge.material.opacity = 0.05;
        } else {
          edge.material.opacity = Math.max(0.18, 0.45 + gn * 0.6 + pulse * 0.15 * (gn || 0.2));
        }
      }
    });

    if (lg.imagePlane && lg.imagePlane.material) {
      lg.imagePlane.material.opacity = isFiltered ? 1.0 : 0.22;
    }

    lg.tiles.forEach(tile => {
      if (tile.material) {
        tile.material.opacity = isFiltered ? 0.95 : 0.18;
      }
    });
  });

  fpsFrames++;
  if (now - fpsLastTime > 1000) {
    document.getElementById('bFPS').textContent = Math.round(fpsFrames * 1000 / (now - fpsLastTime));
    fpsFrames = 0; fpsLastTime = now;
  }

  renderer.render(scene, camera);
}

/* ─── THROTTLED HOVER RAYCASTER ─── */
function performHoverRaycast() {
  raycaster.setFromCamera(mouse, camera);
  const allClickables = layerGroups.flatMap(lg => [...lg.tiles, ...(lg.imagePlane ? [lg.imagePlane] : [])]);
  const intersects = raycaster.intersectObjects(allClickables);
  const tip = document.getElementById('tip');

  if (intersects.length > 0) {
    const hit = intersects[0].object;
    const u = hit.userData;

    if (u.isImageStage) {
      document.getElementById('tipName').textContent = `${u.layerName} [Image Status]`;
      document.getElementById('tipType').textContent = `${u.type} Image Plane`;
      document.getElementById('tipCh').textContent = u.tag === 'output' ? 'Final Classified Image' : `Full ${u.shape[1]}ch view`;
    } else {
      document.getElementById('tipName').textContent = `#${u.layerIdx} ${u.layerName} [Ch ${u.tileIdx}]`;
      document.getElementById('tipType').textContent = u.type || 'Conv';
      document.getElementById('tipCh').textContent = `${u.tileIdx + 1} of ${u.shape[1]}`;
    }

    document.getElementById('tipSp').textContent = `${u.shape[2] || 640} × ${u.shape[3] || 640} px`;
    const gn = gradNorms[u.layerIdx];
    document.getElementById('tipGn').textContent = gn != null ? (gn * 100).toFixed(1) + '%' : '–';
    document.getElementById('tipP').textContent = (u.params || 0).toLocaleString();

    tip.style.display = 'block';
    tip.style.left = Math.min(mouseScreenPos.x + 16, window.innerWidth - 200) + 'px';
    tip.style.top = Math.min(mouseScreenPos.y - 12, window.innerHeight - 180) + 'px';
  } else {
    tip.style.display = 'none';
  }
}

/* ─── STAGE FOCUS & SMOOTH CAMERA GLIDE ─── */
function focusStageType(tag) {
  activeStageFilter = tag;

  document.querySelectorAll('.arch-pill').forEach(btn => {
    btn.classList.remove('active');
  });
  event?.target?.classList?.add('active');

  const pillNames = {
    'all': 'All Network', 'input': '1. Input Image', 'conv': '2. Convolution (Conv)',
    'bn': '3. Batch Normalization (BN)', 'silu': '4. Activation (SiLU)',
    'c2f': '5. C2f / C3k2 Bottleneck', 'sppf': '6. SPPF Multi-Scale',
    'upsample': '7. Upsample (2×)', 'concat': '8. Concat Fusion',
    'detect': '9. Detect Head', 'output': '10. Final Result'
  };
  document.getElementById('bActiveFilter').textContent = pillNames[tag] || tag;

  if (tag === 'all') {
    resetCam();
    return;
  }

  const match = layerGroups.find(lg => lg.meta.tag === tag);
  if (match) {
    const tgtDist = (tag === 'output') ? 450 : 490;
    glideCameraTo(match.x, 0, tgtDist);
    currentSelectedLayer = match.meta;
    updateInspectorWithLayer(match.meta);
    openStageDeepDive(tag);
  }
}

function glideCameraTo(tgtX, tgtY, distZ) {
  if (!controls) return;
  const startCam = camera.position.clone();
  const endCam = new THREE.Vector3(tgtX, tgtY + 30, distZ);
  const startTgt = controls.target.clone();
  const endTgt = new THREE.Vector3(tgtX, tgtY, 0);

  smoothTransition(progress => {
    camera.position.lerpVectors(startCam, endCam, progress);
    controls.target.lerpVectors(startTgt, endTgt, progress);
  }, 450);
}

