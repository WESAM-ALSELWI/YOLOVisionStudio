@model YOLOVisionStudio.Services.ArchitectureResponse
@{
    ViewData["Title"] = "Network Architecture — End-to-End";
    var layersJson = System.Text.Json.JsonSerializer.Serialize(Model?.Layers ?? new List<YOLOVisionStudio.Services.LayerNode>());
}

<div class="glass-card" style="margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
    <div>
        <select id="modelVersion" class="form-control" style="width:140px; display:inline-block;">
            <option value="v11" selected>YOLO v11</option>
            <option value="v8">YOLO v8</option>
        </select>
        <select id="modelSize" class="form-control" style="width:150px; display:inline-block;">
            <option value="n" selected>Nano (fastest)</option>
            <option value="s">Small</option>
            <option value="m">Medium</option>
            <option value="l">Large</option>
            <option value="x">XLarge</option>
        </select>
        <button class="btn btn-primary" onclick="loadArch()">Load Architecture</button>
    </div>
    <div>
        <span class="badge badge-info">Params: @(Model != null ? (Model.TotalParameters / 1_000_000.0).ToString("F2") + "M" : "—")</span>
        <span class="badge badge-warning">FLOPs: @(Model != null && Model.TotalFlops > 0 ? Model.TotalFlops.ToString("F2") + "G" : "—")</span>
    </div>
</div>

@if (Model == null || !Model.Layers.Any())
{
    <div class="glass-card" style="text-align:center; padding:3rem;">
        <div style="font-size:3rem;">🧠</div>
        <h3>Could not load the architecture</h3>
        <p class="text-muted">Make sure the AI engine is running and the model file has been downloaded once, then click Load Architecture.</p>
    </div>
}
else
{
    <!-- Beginner intro -->
    <div class="card mb-4" style="border-left:4px solid var(--color-primary-start);">
        <h5 style="margin-bottom:6px;">👀 How to read this</h5>
        <p style="margin:0; font-size:0.85rem; color:var(--text-secondary); line-height:1.7;">
            An image (<b>1 × 3 × 640 × 640</b>) enters at the top and flows through every layer below.
            Watch the numbers change: <b>height/width shrink</b> while the network looks at bigger things,
            and <b>channels grow</b> as it learns richer features. Click any layer to open its inner blocks
            (every Conv hides a Conv2d → BatchNorm → SiLU trio). Hover a layer type for its plain-English meaning.
        </p>
    </div>

    <!-- Shape flow strip: how the image size evolves end-to-end -->
    <div class="card mb-4">
        <h5 style="margin-bottom:10px;">📐 Data flow — what happens to the image, step by step</h5>
        <div id="flowStrip" style="display:flex; align-items:center; gap:6px; overflow-x:auto; padding:8px 4px;"></div>
    </div>

    <!-- Full recursive tree -->
    <div class="card mb-4">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
            <h5 style="margin:0;">🔍 Every operation inside the network (expand ▸ to go deeper)</h5>
            <button class="btn btn-sm btn-outline" onclick="toggleAll(true)">Expand all</button>
            <button class="btn btn-sm btn-outline" onclick="toggleAll(false)">Collapse all</button>
        </div>
        <div id="layerTree"></div>
    </div>

    <!-- Legend -->
    <div class="card mb-4">
        <h5 style="margin-bottom:10px;">🎨 Color legend</h5>
        <div style="display:flex; flex-wrap:wrap; gap:14px; font-size:0.8rem;">
            <span><span class="dot" style="background:#38bdf8;"></span> Conv / Conv2d — feature detectors</span>
            <span><span class="dot" style="background:#a78bfa;"></span> C2f/C3/Bottleneck — pattern combiners</span>
            <span><span class="dot" style="background:#fb923c;"></span> Pooling — map shrinking</span>
            <span><span class="dot" style="background:#34d399;"></span> Head (Detect) — final boxes</span>
            <span><span class="dot" style="background:#f472b6;"></span> Upsample/Concat — detail recovery &amp; merging</span>
            <span><span class="dot" style="background:#facc15;"></span> Linear / FC — fully connected math</span>
            <span><span class="dot" style="background:#94a3b8;"></span> Norm/Activation/wiring</span>
        </div>
    </div>
}

<style>
.dot { display:inline-block; width:11px; height:11px; border-radius:50%; margin-right:5px; }
.flow-chip { min-width:110px; text-align:center; padding:8px 12px; border-radius:var(--radius-md);
    background:rgba(124,58,237,.07); border:1px solid rgba(124,58,237,.25); font-size:.72rem; line-height:1.5; }
.flow-arrow { color:var(--color-primary-end); font-size:1rem; font-weight:bold; }
.layer-row { display:flex; align-items:center; gap:10px; padding:7px 10px; border-radius:var(--radius-md);
    border:1px solid transparent; cursor:pointer; transition:background .15s; font-size:.78rem; }
.layer-row:hover { background:rgba(124,58,237,.06); }
.layer-row.has-kids { border-color:var(--color-border); margin:3px 0; }
.layer-caret { width:16px; text-align:center; color:var(--color-primary-end); user-select:none; }
.layer-type { font-weight:700; min-width:86px; }
.badge-shape { font-family:monospace; font-size:.68rem; background:rgba(6,182,212,.1);
    color:var(--color-primary-end); padding:2px 7px; border-radius:6px; white-space:nowrap; }
.badge-meta { font-size:.65rem; color:var(--text-muted); white-space:nowrap; }
.plain-tip { font-style:normal; }
.kids { overflow:hidden; }
.param-bar { height:4px; border-radius:2px; background:linear-gradient(90deg,var(--color-primary-start),var(--color-primary-end)); max-width:120px; }
</style>

@section Scripts {
<script>
const LAYERS = @Html.Raw(layersJson);

function category(type) {
    if (/^(Conv|Conv2d)$/.test(type)) return '#38bdf8';
    if (/^(C2f|C3|C3k2|C3k|Bottleneck|SPPF)$/.test(type)) return '#a78bfa';
    if (/Pool/.test(type)) return '#fb923c';
    if (/^(Detect|Segment|Pose|OBB|Classify|DFL)$/.test(type)) return '#34d399';
    if (/^(Upsample|Concat)$/.test(type)) return '#f472b6';
    if (/^Linear$/.test(type)) return '#facc15';
    return '#94a3b8';
}
const fmtShape = s => s && s.length ? '[' + s.join(' × ') + ']' : '';
const fmtNum = n => n >= 1e6 ? (n/1e6).toFixed(2)+'M' : n >= 1e3 ? (n/1e3).toFixed(1)+'K' : ''+n;

// ---- data-flow strip: top-level layers with changing spatial sizes ----
(function buildFlow() {
    const strip = document.getElementById('flowStrip');
    if (!strip) return;
    let prev = null;
    const addChip = (label, shape, color) => {
        strip.insertAdjacentHTML('beforeend',
            `<div class="flow-chip" ${color?`style="border-color:${color}"`:''}><b>${label}</b><br>${shape}</div>`);
    };
    LAYERS.forEach((l, i) => {
        const out = l.output_shape;
        if (!out || out.length !== 4) return;
        if (prev === null) addChip('Input image', fmtShape(out), category(l.type));
        else {
            strip.insertAdjacentHTML('beforeend', '<span class="flow-arrow">→</span>');
            addChip(`${i}. ${l.type}`, fmtShape(out), category(l.type));
        }
        prev = out;
    });
    strip.insertAdjacentHTML('beforeend', '<span class="flow-arrow">→</span><div class="flow-chip" style="border-color:#34d399"><b>Predictions</b><br>boxes + classes</div>');
})();

// ---- recursive tree rendering ----
const domId = node => 'N' + node.id.replace(/[^a-zA-Z0-9]/g, '_');
function renderLayer(node, depth) {
    const kids = node.children || [];
    const id = domId(node);
    const out = node.output_shape, inp = node.input_shape;
    const meta = [];
    if (node.kernel) meta.push('kernel ' + node.kernel);
    if (node.stride && node.stride !== '(1,)') meta.push('stride ' + node.stride.replace(/[()]/g,''));
    if (node.activation) meta.push('act: ' + node.activation);
    if (node.flops > 0) meta.push('~' + node.flops + ' GFLOPs');

    let html = `
    <div class="layer-row ${kids.length?'has-kids':''}" style="margin-left:${depth*18}px;"
         title="${(node.plain||node.details||node.type).replace(/"/g,'')}">
        <span class="layer-caret" id="${id}-caret" onclick="event.stopPropagation(); toggle('${id}')">${kids.length?'▸':''}</span>
        <span class="dot" style="background:${category(node.type)}"></span>
        <span class="layer-type" style="color:${category(node.type)}">${node.name}. ${node.type}</span>
        ${inp && out ? `<span class="badge-shape">${fmtShape(inp)} → ${fmtShape(out)}</span>` : ''}
        ${meta.length ? `<span class="badge-meta">${meta.join(' · ')}</span>` : ''}
        <span style="flex:1"></span>
        ${node.parameters ? `<span class="badge-meta">${fmtNum(node.parameters)} params</span>` : ''}
    </div>`;
    if (kids.length) {
        html += `<div class="kids" id="${id}-kids" style="display:none; border-left:2px dashed var(--color-border); margin-left:${depth*18+9}px;">`;
        kids.forEach(k => html += renderLayer(k, depth + 1));
        html += `</div>`;
    }
    return html;
}

(function buildTree() {
    const tree = document.getElementById('layerTree');
    if (!tree) return;
    let html = '';
    LAYERS.forEach(l => html += renderLayer(l, 0));
    tree.innerHTML = html;

    // auto-expand the first level so beginners see inner structure immediately
    LAYERS.forEach(l => { if ((l.children || []).length) toggle(domId(l), true); });
})();

function toggle(id, forceOpen) {
    const kids = document.getElementById(id + '-kids');
    const caret = document.getElementById(id + '-caret');
    if (!kids) return;
    const show = forceOpen === true ? true : kids.style.display === 'none';
    kids.style.display = show ? 'block' : 'none';
    if (caret) caret.textContent = show ? '▾' : '▸';
}
function toggleAll(open) {
    document.querySelectorAll('.kids').forEach(k => k.style.display = open ? 'block' : 'none');
    document.querySelectorAll('.layer-caret').forEach(c => { if (c.textContent.trim()) c.textContent = open ? '▾' : '▸'; });
}

function loadArch() {
    const v = document.getElementById('modelVersion').value;
    const s = document.getElementById('modelSize').value;
    window.location.href = `/Visualization/Architecture?version=${v}&size=${s}`;
}
</script>
}
